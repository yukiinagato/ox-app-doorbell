        "effects": [
          {"at": 1, "kind": "alert_present", "channel": "in_app", "active": true, "sticky": true, "ttl_s": 0},
          {"at": 2, "kind": "alert_present", "channel": "system_notification", "active": true, "sticky": false, "ttl_s": 5},
          {"at": 4, "kind": "alert_expire", "channel": "system_notification"},
          {"at": 6, "kind": "alert_clear", "channel": "in_app", "active": false, "sticky": false, "ttl_s": 10},
          {"at": 6, "kind": "alert_clear", "channel": "system_notification", "active": false, "sticky": false, "ttl_s": 10}
        ],
        "rejections": [],
        "state_transitions": [
          {"at": 0, "active": true},
          {"at": 5, "active": false}
        ],
        "emergency_active": false,
        "presentations": {}
      }
    },
