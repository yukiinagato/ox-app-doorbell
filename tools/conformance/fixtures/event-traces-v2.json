      "name": "sos-state-and-local-channels-remain-independent",
      "requires_channels": ["in_app", "system_notification"],
      "now_ms": 1000,
      "events": [
        {"schema_version": 2, "t": "event", "type": "emergency"},
        {
          "schema_version": 2,
          "t": "emergency",
          "active": true,
          "trigger": "emergency_on",
          "targets": {"roles": ["indoor_panel"]},
          "channels": ["in_app"],
          "sticky": true,
          "ttl_s": 0
        },
        {
          "schema_version": 2,
          "t": "emergency",
          "active": true,
          "trigger": "emergency_on",
          "targets": {"devices": ["panel-local"]},
          "channels": ["system_notification"],
          "sticky": false,
          "ttl_s": 5
        },
        {"t": "tick", "advance_ms": 4999},
        {"t": "tick", "advance_ms": 1},
        {"schema_version": 2, "t": "event", "type": "emergency_cancel"},
        {
          "schema_version": 2,
          "t": "emergency",
          "active": false,
          "trigger": "emergency_off",
          "targets": {"devices": ["panel-local"]},
          "channels": ["in_app", "system_notification"],
          "sticky": false,
          "ttl_s": 10
        }
      ],
