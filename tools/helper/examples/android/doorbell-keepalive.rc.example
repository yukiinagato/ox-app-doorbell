# Replace 12345 with the installed jp.keihan.doorbell UID and install the
# binary, socket directory policy, and SELinux policy as one reviewed image.
service doorbell_keepalive /system/xbin/doorbell-keepalive --socket /dev/socket/doorbell_keeper --status /data/misc/doorbell/keepalive-status.json --marker /data/misc/doorbell/keepalive-safe-mode.json --mode-file /data/misc/doorbell/keepalive-mode --mode auto --profile android --app-uid 12345 --socket-gid 12345
    class late_start
    user root
    group root
    disabled
    seclabel u:r:doorbell_keepalive:s0

on property:sys.boot_completed=1
    start doorbell_keepalive
