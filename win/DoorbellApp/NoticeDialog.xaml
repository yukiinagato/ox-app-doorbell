<Window x:Class="DoorbellApp.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <Grid>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Left" Foreground="{DynamicResource Fg}"/>
            <WrapPanel x:Name="TargetRow" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Grid>
        <TextBox x:Name="BodyBox" Margin="0,16,0,0" FontSize="18" MinHeight="96"
                 AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10"
                 VerticalScrollBarVisibility="Auto"/>
        <WrapPanel x:Name="PresetRow" Orientation="Horizontal" Margin="0,12,0,0"/>
        <WrapPanel Margin="0,14,0,0" Orientation="Horizontal">
            <TextBlock x:Name="ExpiryLabel" FontSize="15" VerticalAlignment="Center"
                       Margin="0,0,10,0" Foreground="{DynamicResource Dim}"/>
            <WrapPanel x:Name="ExpiryRow" Orientation="Horizontal" Margin="0,0,16,0"/>
            <TextBlock x:Name="LimitText" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource Dim}"/>
        </WrapPanel>
        <StackPanel x:Name="CustomHoursRow" Orientation="Horizontal" Margin="0,10,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="CustomHoursLabel" FontSize="15" VerticalAlignment="Center"
                       Foreground="{DynamicResource Dim}"/>
            <TextBox x:Name="CustomHoursBox" Width="96" Margin="10,0,0,0" FontSize="16"
                     MinHeight="44" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource Negative}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ClearButton" Style="{StaticResource PairSecondaryButton}"
                    Foreground="{DynamicResource Negative}" Click="OnClearClick"/>
            <Button x:Name="CancelButton" Style="{StaticResource PairSecondaryButton}"
                    Margin="10,0,0,0" Click="OnCancelClick"/>
            <Button x:Name="PublishButton" Style="{StaticResource PairPrimaryButton}"
                    Margin="10,0,0,0" Click="OnPublishClick"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
