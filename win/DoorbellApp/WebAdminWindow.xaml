<Window x:Class="DoorbellApp.WebAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <StackPanel Margin="26">
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg}"/>
        <TextBlock x:Name="HintText" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource Dim}"/>
        <Border Margin="0,16,0,0" Padding="16" Style="{StaticResource CardBorder}">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="QrImage" Width="200" Height="200"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UrlText" FontSize="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg}"/>
                    <StackPanel x:Name="OtherAddresses" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource NegativeText}"/>
        <!-- In-app updates (UpdateChecker): only offered on installer-based deployments. -->
        <Border x:Name="UpdateCard" Margin="0,16,0,0" Padding="16"
                Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="UpdateTitle" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}"/>
                <TextBlock x:Name="UpdateStatus" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource Dim}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="UpdateCheckButton" Style="{StaticResource PairSecondaryButton}"
                            Click="OnUpdateCheckClick"/>
                    <Button x:Name="UpdateApplyButton" Style="{StaticResource PairPrimaryButton}"
                            Margin="12,0,0,0" Visibility="Collapsed" Click="OnUpdateApplyClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OpenButton" Style="{StaticResource PairPrimaryButton}"
                    Click="OnOpenClick"/>
            <Button x:Name="CloseButton" Style="{StaticResource PairSecondaryButton}"
                    Margin="12,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</Window>
