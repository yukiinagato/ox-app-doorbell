<!-- Native settings controls: the Fluent (ModernWpf) controls at touch size. Every interactive
     element is at least 44 device-independent pixels tall so it stays usable with a finger on a
     Toughpad; WPF scales DIPs with the system DPI. The on/off switch is ModernWpf's ToggleSwitch,
     created in code (DoorbellApp.Ui.Fluent.Switch) with the same 44-pixel minimum. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A whole-row target inside a list or popup: the Fluent button without its plate. -->
    <Style x:Key="SettingsFlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <!-- A command on the right of a row (Open, Add, Reset): the standard Fluent button. -->
    <Style x:Key="SettingsCommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Padding" Value="16,6"/>
    </Style>

    <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem"
           BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}"/>
    </Style>
</ResourceDictionary>
