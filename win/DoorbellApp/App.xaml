<Application x:Class="DoorbellApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent (WinUI) theme and control styles. DoorbellApp.Util.Appearance drives
                     ThemeManager from Core's effective appearance and accent. -->
                <ui:ThemeResources/>
                <ui:XamlControlsResources/>
                <!-- Tabler Icons, generated by tools/gen_icons.py. -->
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <!-- Touch-sized variants of the Fluent controls used by native settings. -->
                <ResourceDictionary Source="Settings/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Neutral tokens. These are aliases: DoorbellApp.Util.Appearance re-points each one at
             the matching ModernWpf theme brush whenever the appearance or accent changes, so
             every consumer must use DynamicResource. The values below only cover the moment
             before the first Appearance pass. -->
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#33FFFFFF"/>
        <!-- Card material over the wallpaper (Ui/Frost) and its hairline, pill and row tints. -->
        <SolidColorBrush x:Key="Plate" Color="#A62B2B2B"/>
        <SolidColorBrush x:Key="PlateLine" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="Pill" Color="#CC2B2B2B"/>
        <SolidColorBrush x:Key="Row" Color="#14FFFFFF"/>
        <!-- Fixed semantic roles (ui-guidelines section 3). They do not come from the Fluent
             theme; Appearance swaps the light and dark variants. -->
        <SolidColorBrush x:Key="Positive" Color="#1E8E4B"/>
        <SolidColorBrush x:Key="OnPositive" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Danger" Color="#C0392B"/>
        <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB454"/>
        <SolidColorBrush x:Key="Ok" Color="#5DD39E"/>
        <SolidColorBrush x:Key="Notice" Color="#B7791F"/>
        <SolidColorBrush x:Key="Track" Color="#802A21"/>
        <SolidColorBrush x:Key="Surface" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="OnSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Negative" Color="#C0392B"/>
        <SolidColorBrush x:Key="OnNegative" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Warning" Color="#FFB454"/>
        <SolidColorBrush x:Key="Muted" Color="#99FFFFFF"/>

        <!-- Fluent buttons keep WPF's stretch layout: the shell's grids and docks were laid out
             for it, and a button that hugs its label is a smaller touch target. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- Standard command: the Fluent button at touch size. -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- The selected one of a row of standard commands (history filters). -->
        <Style x:Key="ChipAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- The one primary action of a screen: the Fluent accent button, enlarged. -->
        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- The same size for a screen's secondary full-width action (Cancel). -->
        <Style x:Key="BigSecondaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- Shared pairing surfaces (onboarding, add-device panel, QR scanner). -->
        <Style x:Key="PairPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="PairSecondaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- Icon-over-label action on the incoming/monitor screen. -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- Answer, End, SOS cancel: Fluent has no button in a fixed semantic colour, so these
             keep their own fill in every state. Metrics follow the Fluent button; press and
             disabled states only change opacity so the role colour is never replaced. -->
        <Style x:Key="SemanticButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Positive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPositive}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle"
                    Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SemanticActionButton" TargetType="Button" BasedOn="{StaticResource SemanticButton}">
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
        </Style>

        <!-- Standard card: the surface for content that sits over the page or the wallpaper. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Slide-to-trigger SOS: no stock control does this job, so it stays custom-drawn. The
             visible label lives behind the slider inside the semantic "sos.trigger" border, so
             admin style overrides keep addressing that border. -->
        <Style x:Key="SosTrack" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="5" Background="Transparent">
                            <Border IsHitTestVisible="False" Background="#24000000"
                                    CornerRadius="24"/>
                            <Border IsHitTestVisible="False" Background="#14FFFFFF"
                                    BorderBrush="#2EFFFFFF" BorderThickness="1"
                                    CornerRadius="24"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="48" Height="48" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFF7F5" CornerRadius="24"
                                                        Margin="1" BorderBrush="#4D6B1410"
                                                        BorderThickness="1">
                                                    <Viewbox Width="24" Height="24"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconChevronsRight}"
                                                              Stroke="#981D17" StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
