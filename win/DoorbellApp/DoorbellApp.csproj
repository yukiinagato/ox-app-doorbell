<Project Sdk="Microsoft.NET.Sdk">
  <!-- One .NET Framework 4.8 WPF package supports Windows 7 SP1 through Windows 11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <NeutralLanguage>ja</NeutralLanguage>
    <RootNamespace>DoorbellApp</RootNamespace>
    <AssemblyName>DoorbellApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=X:\src\win\DoorbellApp</PathMap>
    <Version>0.1.1</Version>
    <EnableDefaultEmbeddedResourceItems>true</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- JSON and TTS use framework assemblies, with no external runtime dependency. -->
    <!-- System.Web is an explicit transitive dependency of System.Web.Extensions. Omitting it can
         make the newer SDK XAML compiler fail with MC1000 during CI builds. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Speech" />
    <!-- WMI provides remote brightness through WmiMonitorBrightnessMethods. -->
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- win/build.cmd places the native Core DLL in this output tree. -->
    <None Include="lib\**\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\audio\*.mp3">
      <Link>Audio\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
