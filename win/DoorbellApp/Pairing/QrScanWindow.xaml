<Window x:Class="DoorbellApp.Pairing.QrScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#000000" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" WindowStartupLocation="CenterOwner"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform"/>

        <!-- Viewfinder: a fixed frame the operator aims at, over the live preview. -->
        <Border x:Name="Viewfinder" Width="420" Height="420" BorderThickness="4"
                BorderBrush="{StaticResource Accent}" CornerRadius="18"
                Background="Transparent" HorizontalAlignment="Center"
                VerticalAlignment="Center" IsHitTestVisible="False"/>

        <StackPanel x:Name="MessagePanel" Visibility="Collapsed" MaxWidth="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="MessageText" FontSize="24" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource Fg}"/>
        </StackPanel>

        <Border Background="#C0141B22" CornerRadius="14" Padding="26,14"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
            <StackPanel>
                <TextBlock x:Name="HintText" FontSize="20" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="720"
                           Foreground="{StaticResource Fg}"/>
                <TextBlock x:Name="StatusText" FontSize="22" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,10,0,0"
                           Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusDetail" FontSize="12" TextAlignment="Center"
                           Margin="0,4,0,0" Foreground="{StaticResource Dim}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Button x:Name="CancelButton" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,52" Style="{StaticResource PairSecondaryButton}"
                Click="OnCancelClick"/>
    </Grid>
</Window>
