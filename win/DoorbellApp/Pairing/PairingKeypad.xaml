<UserControl x:Class="DoorbellApp.Pairing.PairingKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UniformGrid Columns="3" Rows="4" MaxWidth="330" HorizontalAlignment="Left">
        <UniformGrid.Resources>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="MinHeight" Value="54"/>
                <Setter Property="Background" Value="#0C1014"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="BorderBrush" Value="#2A333D"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#243040"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </UniformGrid.Resources>
        <Button Content="1" Tag="1" Click="OnPad"/>
        <Button Content="2" Tag="2" Click="OnPad"/>
        <Button Content="3" Tag="3" Click="OnPad"/>
        <Button Content="4" Tag="4" Click="OnPad"/>
        <Button Content="5" Tag="5" Click="OnPad"/>
        <Button Content="6" Tag="6" Click="OnPad"/>
        <Button Content="7" Tag="7" Click="OnPad"/>
        <Button Content="8" Tag="8" Click="OnPad"/>
        <Button Content="9" Tag="9" Click="OnPad"/>
        <Button Content="⌫" Tag="back" Click="OnPad"/>
        <Button Content="0" Tag="0" Click="OnPad"/>
        <Button x:Name="ClearButton" Content="C" Tag="clear" Click="OnPad"/>
    </UniformGrid>
</UserControl>
