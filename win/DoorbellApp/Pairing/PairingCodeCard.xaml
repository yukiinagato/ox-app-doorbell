<UserControl x:Class="DoorbellApp.Pairing.PairingCodeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="24"
            BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="AddressLabel" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Dim}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="AddressValue" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                <Button x:Name="AddressCopyButton" Style="{StaticResource PairSecondaryButton}"
                        FontSize="14" Padding="14,4" MinHeight="32" Margin="14,0,0,0"
                        VerticalAlignment="Center" Click="OnCopyAddress"/>
            </StackPanel>
            <TextBlock x:Name="AddressExample" FontSize="13" Foreground="{DynamicResource Dim}"
                       Margin="0,2,0,0"/>

            <TextBlock x:Name="CodeLabel" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Dim}" Margin="0,18,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="CodeValue" FontSize="46" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <Button x:Name="CodeCopyButton" Style="{StaticResource PairSecondaryButton}"
                        FontSize="14" Padding="14,4" MinHeight="32" Margin="18,0,0,0"
                        VerticalAlignment="Center" Click="OnCopyCode"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="CountdownText" FontSize="18"
                           Foreground="{DynamicResource Warn}"/>
                <TextBlock x:Name="AttemptsText" FontSize="18" Margin="18,0,0,0"
                           Foreground="{DynamicResource Dim}"/>
            </StackPanel>

            <TextBlock x:Name="Instructions" FontSize="15" TextWrapping="Wrap"
                       Foreground="{DynamicResource Fg}" Margin="0,14,0,0" MaxWidth="520"
                       HorizontalAlignment="Left"/>

            <StackPanel x:Name="ExpiredPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock x:Name="ExpiredText" FontSize="17" TextWrapping="Wrap"
                           Foreground="#FF6B6B"/>
                <Button x:Name="NewCodeButton" Style="{StaticResource PairPrimaryButton}"
                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnNewCode"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
