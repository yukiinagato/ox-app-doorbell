<Window x:Class="DoorbellApp.Pairing.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pairing="clr-namespace:DoorbellApp.Pairing"
        Background="{DynamicResource Bg}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid Margin="40,28,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MembershipText" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="ConnectedText" FontSize="18" Margin="18,0,0,0"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Dim}"/>
                    <Border x:Name="CreatedBadge" Visibility="Collapsed" Background="#2A3A4C"
                            CornerRadius="8" Padding="10,3" Margin="18,0,0,0"
                            VerticalAlignment="Bottom">
                        <TextBlock x:Name="CreatedBadgeText" FontSize="13"
                                   Foreground="{DynamicResource Fg}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SelfLine" FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource Dim}"/>
            </StackPanel>
            <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource PairSecondaryButton}" Click="OnCloseClick"/>
        </Grid>

        <!-- An unpaired node cannot add anything, so only the two paths that can work are shown. -->
        <StackPanel x:Name="UnpairedPanel" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
            <TextBlock x:Name="UnpairedText" FontSize="22" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{DynamicResource Fg}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="UnpairedCreateButton"
                        Style="{StaticResource PairPrimaryButton}" Click="OnOpenOnboardingClick"/>
                <Button x:Name="UnpairedJoinButton" Margin="14,0,0,0"
                        Style="{StaticResource PairSecondaryButton}"
                        Click="OnOpenOnboardingClick"/>
            </StackPanel>
        </StackPanel>

        <Grid x:Name="PairedPanel" Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" LastChildFill="True">
                <TextBlock x:Name="NearbyTitle" DockPanel.Dock="Top" FontSize="22"
                           FontWeight="Bold" Foreground="{DynamicResource Fg}"
                           Margin="0,0,0,14"/>
                <StackPanel x:Name="NearbyEmptyPanel" DockPanel.Dock="Top" Margin="0,0,0,14">
                    <ProgressBar Height="4" Width="200" HorizontalAlignment="Left"
                                 IsIndeterminate="True" Background="#1A2027"
                                 Foreground="{DynamicResource Accent}" BorderThickness="0"/>
                    <TextBlock x:Name="NearbyEmptyText" FontSize="16" Margin="0,10,0,0"
                               Foreground="{DynamicResource Dim}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="NearbyList" Margin="0,0,20,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Card}" CornerRadius="12"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Fg}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="14"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource Dim}"/>
                                            <TextBlock Text="{Binding Waiting}" FontSize="13"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Dim}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="15"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Foreground="{Binding StatusBrush}"
                                                       Visibility="{Binding StatusVisibility}"/>
                                            <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Dim}"
                                                       Visibility="{Binding DetailVisibility}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <ProgressBar Width="70" Height="4"
                                                         IsIndeterminate="True"
                                                         VerticalAlignment="Center"
                                                         Background="#1A2027" BorderThickness="0"
                                                         Foreground="{DynamicResource Accent}"
                                                         Visibility="{Binding BusyVisibility}"/>
                                            <Button Content="{Binding ActionText}"
                                                    IsEnabled="{Binding CanAct}" Margin="14,0,0,0"
                                                    Style="{StaticResource PairPrimaryButton}"
                                                    Click="OnAddClick"/>
                                            <Button Content="{Binding DenyText}"
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding DenyVisibility}"
                                                    Style="{StaticResource PairSecondaryButton}"
                                                    Click="OnDenyClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <ScrollViewer Grid.Column="1" Width="560" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="24,0,0,0">
                <StackPanel>
                    <Button x:Name="AddWithCodeButton" HorizontalAlignment="Left"
                            Style="{StaticResource PairPrimaryButton}"
                            Click="OnAddWithCodeClick"/>
                    <pairing:PairingCodeCard x:Name="CodeCard" Visibility="Collapsed"
                                             Margin="0,14,0,0"/>

                    <Border Background="{DynamicResource Card}" CornerRadius="16"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AddAllTitle" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AddAllWarning" FontSize="14" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Warn}"/>
                            <Button x:Name="AddAllButton" Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PairSecondaryButton}"
                                    Click="OnAddAllClick"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ScanQrButton" Margin="0,20,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource PairSecondaryButton}" Click="OnScanQrClick"/>

                    <Border Background="{DynamicResource Card}" CornerRadius="16"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="OwnQrTitle" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="8"
                                    Width="200" Height="200" HorizontalAlignment="Left"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <Image x:Name="OwnQrImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock x:Name="OwnQrPlaceholder" FontSize="13"
                                               Foreground="#5A6672" TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A1B1B" CornerRadius="16" BorderBrush="#7F1D1D"
                            BorderThickness="1" Padding="20" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ClearTitle" FontSize="19" FontWeight="Bold"
                                       Foreground="#FF9C9C" TextWrapping="Wrap"/>
                            <Button x:Name="ClearButton" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PairSecondaryButton}"
                                    Click="OnClearClick"/>
                            <StackPanel x:Name="ClearConfirmPanel" Visibility="Collapsed"
                                        Margin="0,12,0,0">
                                <TextBlock x:Name="ClearConfirmText" FontSize="15"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fg}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ClearConfirmYes"
                                            Style="{StaticResource PairPrimaryButton}"
                                            Click="OnClearConfirmClick"/>
                                    <Button x:Name="ClearConfirmNo" Margin="12,0,0,0"
                                            Style="{StaticResource PairSecondaryButton}"
                                            Click="OnClearCancelClick"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
