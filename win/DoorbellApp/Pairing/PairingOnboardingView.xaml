<UserControl x:Class="DoorbellApp.Pairing.PairingOnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pairing="clr-namespace:DoorbellApp.Pairing"
             FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid Background="{DynamicResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,32,48,40" MaxWidth="1180" HorizontalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="38" FontWeight="Bold"
                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                <TextBlock x:Name="IdentityText" FontSize="16" Margin="0,10,0,0"
                           Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>

                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel x:Name="StatusPanel">
                            <ProgressBar x:Name="StatusSpinner" Height="4" Width="260"
                                         HorizontalAlignment="Left" IsIndeterminate="True"
                                         Foreground="{DynamicResource Accent}"
                                         Background="#1A2027" BorderThickness="0"/>
                            <TextBlock x:Name="StatusText" FontSize="27" FontWeight="SemiBold"
                                       Margin="0,14,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg}"/>
                            <TextBlock x:Name="StatusHint" FontSize="17" Margin="0,10,0,0"
                                       TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource Dim}"/>
                        </StackPanel>

                        <StackPanel x:Name="ActionsPanel" Orientation="Horizontal"
                                    Margin="0,28,0,0">
                            <Button x:Name="JoinWithCodeButton"
                                    Style="{StaticResource PairPrimaryButton}"
                                    Click="OnJoinWithCodeClick"/>
                            <Button x:Name="CreateHomeButton" Margin="14,0,0,0"
                                    Style="{StaticResource PairSecondaryButton}"
                                    Click="OnCreateHomeClick"/>
                            <Button x:Name="LaterButton" Margin="14,0,0,0"
                                    Style="{StaticResource PairSecondaryButton}"
                                    Click="OnLaterClick"/>
                        </StackPanel>

                        <!-- Two-step confirm: creating a Cluster on the wrong device is the most
                             common onboarding mistake, so it is never a single tap. -->
                        <Border x:Name="CreateConfirmPanel" Visibility="Collapsed"
                                Background="{DynamicResource Card}" CornerRadius="16"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="24"
                                Margin="0,22,0,0" HorizontalAlignment="Left" MaxWidth="620">
                            <StackPanel>
                                <TextBlock x:Name="CreateConfirmText" FontSize="17"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fg}"/>
                                <TextBlock x:Name="CreateError" FontSize="16"
                                           TextWrapping="Wrap" Margin="0,14,0,0"
                                           Foreground="#FF6B6B" Visibility="Collapsed"/>
                                <TextBlock x:Name="CreateErrorDetail" FontSize="12"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Dim}"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="CreateConfirmYes"
                                            Style="{StaticResource PairPrimaryButton}"
                                            Click="OnCreateConfirmClick"/>
                                    <Button x:Name="CreateConfirmNo" Margin="14,0,0,0"
                                            Style="{StaticResource PairSecondaryButton}"
                                            Click="OnCreateCancelClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CodeEntryPanel" Visibility="Collapsed"
                                Background="{DynamicResource Card}" CornerRadius="16"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="24"
                                Margin="0,22,0,0" HorizontalAlignment="Left" MaxWidth="620">
                            <StackPanel>
                                <TextBlock x:Name="EntryAddressLabel" FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Dim}"/>
                                <TextBox x:Name="AddressBox" FontSize="22" Margin="0,6,0,0"
                                         MinHeight="44" Padding="10,6" MaxLength="128"
                                         Background="#0C1014" Foreground="{DynamicResource Fg}"
                                         CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Line}"/>
                                <TextBlock x:Name="EntryAddressExample" FontSize="13"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource Dim}"/>

                                <TextBlock x:Name="EntryCodeLabel" FontSize="15"
                                           FontWeight="SemiBold" Margin="0,18,0,0"
                                           Foreground="{DynamicResource Dim}"/>
                                <TextBlock x:Name="CodeDisplay" FontSize="40" FontWeight="Bold"
                                           MinHeight="52" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Fg}"/>
                                <pairing:PairingKeypad x:Name="Keypad" Margin="0,8,0,0"
                                                       HorizontalAlignment="Left"/>

                                <TextBlock x:Name="EntryError" FontSize="16" TextWrapping="Wrap"
                                           Margin="0,14,0,0" Foreground="#FF6B6B"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="EntryErrorDetail" FontSize="12"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Dim}"
                                           Visibility="Collapsed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="JoinButton"
                                            Style="{StaticResource PairPrimaryButton}"
                                            Click="OnJoinClick"/>
                                    <Button x:Name="JoinBackButton" Margin="14,0,0,0"
                                            Style="{StaticResource PairSecondaryButton}"
                                            Click="OnJoinBackClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- After creating a Cluster the code card stays on screen; it is never
                             auto-dismissed, because the operator has to read the PIN from it. -->
                        <StackPanel x:Name="CreatedPanel" Visibility="Collapsed"
                                    Margin="0,22,0,0" HorizontalAlignment="Left" MaxWidth="620">
                            <TextBlock x:Name="CreatedTitle" FontSize="26" FontWeight="Bold"
                                       Foreground="#5DD39E" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CreatedNext" FontSize="18" Margin="0,8,0,16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
                            <pairing:PairingCodeCard x:Name="CreatedCodeCard"/>
                            <Button x:Name="CreatedLaterButton" Margin="0,18,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PairSecondaryButton}"
                                    Click="OnLaterClick"/>
                        </StackPanel>

                        <Border x:Name="PersistErrorPanel" Visibility="Collapsed"
                                Background="#2A1B1B" CornerRadius="16" BorderBrush="#7F1D1D"
                                BorderThickness="1" Padding="24" Margin="0,22,0,0"
                                HorizontalAlignment="Left" MaxWidth="620">
                            <StackPanel>
                                <TextBlock x:Name="PersistErrorTitle" FontSize="24"
                                           FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="#FF9C9C"/>
                                <TextBlock x:Name="PersistErrorBody" FontSize="16"
                                           Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fg}"/>
                                <Button x:Name="RetryButton" Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PairPrimaryButton}"
                                        Click="OnRetryClick"/>
                                <TextBlock x:Name="RetryResult" FontSize="15" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Foreground="#FF9C9C"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="40,0,0,0" Width="300">
                        <Border Background="#FFFFFF" CornerRadius="12" Padding="10"
                                Width="280" Height="280">
                            <Grid>
                                <Image x:Name="QrImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="QrPlaceholder" FontSize="15"
                                           Foreground="#5A6672" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="QrCaption" FontSize="14" Margin="0,12,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource Dim}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
