<Window x:Class="DoorbellApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pairing="clr-namespace:DoorbellApp.Pairing"
        xmlns:ui="clr-namespace:DoorbellApp.Ui"
        Title="ドアホン" Background="{DynamicResource Bg}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" Cursor="Arrow" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid ClipToBounds="True">
        <Image x:Name="ThemeBgImage" Stretch="UniformToFill" Visibility="Collapsed"
               IsHitTestVisible="False"/>
        <!-- The scrim that makes text and cards read over a bright wallpaper. It is a sibling
             drawn immediately after the picture and before every screen, so it darkens the
             picture and never the door tiles, the call list or any other plate above it.
             Colour and opacity come from display.theme.backdrop. -->
        <Border x:Name="ThemeBackdrop" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Grid x:Name="IdleView">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IdleShift"/>
            </Grid.RenderTransform>

            <!-- Hidden 7-tap corner, drawn first so the dashboard chips above it still take
                 their own taps; panels without a background never steal one. -->
            <Border x:Name="SecretCorner" Width="200" Height="200" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MouseLeftButtonDown="OnSecretCorner"/>

            <!-- B · door-station visitor screen. Row and column placement is recomputed from the
                 window size, so the same elements serve portrait and landscape. -->
            <Grid x:Name="VisitorHome" Margin="26,22,26,18" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VisitorLeftColumn" Width="*"/>
                    <ColumnDefinition x:Name="VisitorRightColumn" Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="VisitorClockBlock" Grid.Row="0" Grid.Column="0">
                    <TextBlock x:Name="ClockText" FontSize="76" FontWeight="Light"
                               Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="DateText" FontSize="24"
                               Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border x:Name="VisitorNoticeCard" Grid.Row="1" Grid.Column="0"
                        Visibility="Collapsed" Margin="0,16,0,0" CornerRadius="12"
                        Padding="16,12" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Notice}" BorderThickness="1,1,1,4"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="VisitorNoticeText" FontSize="22" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg}"/>
                </Border>

                <StackPanel x:Name="LangBar" Grid.Row="2" Grid.Column="1"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,10,0,10" Visibility="Collapsed"/>

                <StackPanel x:Name="VisitorCallBlock" Grid.Row="3" Grid.Column="1"
                            VerticalAlignment="Center">
                    <Button x:Name="CallButton" Style="{StaticResource BigButton}"
                            MinWidth="360" MinHeight="150" Click="OnCallClick"/>
                </StackPanel>

                <TextBlock x:Name="TouchHint" Grid.Row="4" Grid.Column="1" FontSize="20"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource Dim}" Margin="0,14,0,0"/>

                <StackPanel x:Name="PurposeSection" Grid.Row="5" Grid.Column="0"
                            Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,14,0,6">
                    <TextBlock x:Name="PurposeHint" FontSize="18"
                               Foreground="{DynamicResource Dim}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <UniformGrid x:Name="PurposeGrid" Columns="3"
                                     HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </StackPanel>

                <Grid x:Name="VisitorFooter" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                      Margin="0,12,0,0">
                    <TextBlock x:Name="VisitorVersionLine" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource Dim}" HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- A · indoor dashboard. -->
            <Grid x:Name="DashboardHome" Margin="22,18,22,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock x:Name="DashClock" FontSize="52" FontWeight="Light"
                                   Foreground="{DynamicResource Fg}"/>
                        <TextBlock x:Name="DashDate" FontSize="16"
                                   Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="DashboardChips" Orientation="Horizontal"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Border x:Name="MembershipStatus" Visibility="Collapsed" Cursor="Hand"
                                Background="{DynamicResource Card}" CornerRadius="10"
                                Padding="12,6" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" Margin="5,0,0,0"
                                MouseLeftButtonDown="OnMembershipClick">
                            <!-- Three compact counters: the cluster, then how many door stations
                                 and indoor panels are online. Vector icons, never emoji, so they
                                 take the ink colour and stay crisp at any scale. -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel x:Name="ClusterCounter" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTopologyStar3}" Stroke="{DynamicResource Dim}"
                                              StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="ClusterCountText" FontSize="14"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg}"/>
                                </StackPanel>
                                <StackPanel x:Name="DoorCounter" Orientation="Horizontal"
                                            Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDoor}" Stroke="{DynamicResource Dim}"
                                              StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="DoorCountText" FontSize="14"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg}"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelCounter" Orientation="Horizontal"
                                            Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDeviceTablet}" Stroke="{DynamicResource Dim}"
                                              StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="PanelCountText" FontSize="14"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MissedBadge" Visibility="Collapsed" Cursor="Hand"
                                Background="{DynamicResource Danger}" CornerRadius="10"
                                Padding="12,6" Margin="5,0,0,0"
                                MouseLeftButtonDown="OnMissedBadgeClick">
                            <TextBlock x:Name="MissedBadgeText" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource OnDanger}"/>
                        </Border>
                        <Button x:Name="OpenMonitorButton" Style="{StaticResource ChipButton}"
                                BorderBrush="{DynamicResource Line}" Visibility="Collapsed"
                                Click="OnOpenMonitorClick"/>
                        <Button x:Name="AdminEntryButton" Style="{StaticResource ChipButton}"
                                BorderBrush="{DynamicResource Line}" Click="OnAdminEntryClick"/>
                        <Ellipse x:Name="MeshDot" Width="12" Height="12"
                                 Fill="{DynamicResource Ok}" Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </WrapPanel>
                </Grid>

                <Grid x:Name="DashboardContent" Grid.Row="1" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DashboardLeftColumn" Width="1.4*"/>
                        <ColumnDefinition x:Name="DashboardRightColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="DashboardTopRow" Height="*"/>
                        <RowDefinition x:Name="DashboardBottomRow" Height="0"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="DoorTilesPanel" Grid.Row="0" Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                        <UniformGrid x:Name="DoorTileGrid" Columns="2"/>
                    </ScrollViewer>

                    <Border x:Name="RecentCallsPanel" Grid.Row="0" Grid.Column="1"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="12" Padding="12,10" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="RecentCallsTitle" FontSize="16"
                                           FontWeight="Bold" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource Fg}"/>
                                <Button x:Name="SeeAllCallsButton"
                                        Style="{StaticResource ChipButton}"
                                        BorderBrush="{DynamicResource Line}"
                                        HorizontalAlignment="Right" Click="OnOpenHistoryClick"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RecentCallsList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="DashboardFooter" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Width is reserved at runtime from the SOS slider's real footprint. -->
                        <ColumnDefinition x:Name="DashboardSosColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AdminLinkCard" Grid.Column="0" Cursor="Hand"
                            Background="{DynamicResource Card}" CornerRadius="10" Padding="12,6"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            MouseLeftButtonDown="OnWebAdminClick">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="AdminQrImage" Width="52" Height="52"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AdminLinkTitle" FontSize="13"
                                           Foreground="{DynamicResource Dim}"/>
                                <TextBlock x:Name="AdminUrlText" FontSize="14"
                                           Foreground="{DynamicResource Fg}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NodeInfo" Grid.Column="1" FontSize="14"
                               Margin="14,0,10,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                    <Button x:Name="NoticeGlobalButton" Grid.Column="2"
                            Style="{StaticResource ChipButton}"
                            BorderBrush="{DynamicResource Line}" VerticalAlignment="Center"
                            Click="OnGlobalNoticeClick"/>
                </Grid>
            </Grid>

            <!-- Slide-to-trigger SOS. The semantic id "sos.trigger" keeps addressing this border,
                 so an administrator's style override still applies to the visible control. -->
            <Border x:Name="SosButton" Visibility="Collapsed"
                    Background="{DynamicResource Danger}" CornerRadius="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,16" Width="238" Height="62">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False" Margin="60,6,12,6">
                        <TextBlock x:Name="SosText" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource OnDanger}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SosHint" FontSize="13" Opacity="0.85"
                                   Foreground="{DynamicResource OnDanger}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ui:SosSlider x:Name="SosSlide" Style="{StaticResource SosTrack}"/>
                </Grid>
            </Border>

        </Grid>

        <Grid x:Name="CallingView" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CallingText" FontSize="56" FontWeight="Bold"
                           Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                <Ellipse x:Name="Pulse" Width="140" Height="140" Margin="0,50"
                         Stroke="{DynamicResource Accent}" StrokeThickness="6"
                         HorizontalAlignment="Center"/>
                <StackPanel x:Name="CallingPurposeSection" Visibility="Collapsed" Margin="20,0,20,24">
                    <TextBlock x:Name="CallingPurposeHint" FontSize="20"
                               Foreground="{DynamicResource Dim}" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <UniformGrid x:Name="CallingPurposeGrid" Columns="3"
                                 HorizontalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CancelButton" FontSize="28" Padding="40,16"
                        Background="{DynamicResource Card}" Foreground="{DynamicResource Fg}"
                        BorderBrush="{DynamicResource Line}" Click="OnCancelClick"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ReplyBanner" Visibility="Collapsed" VerticalAlignment="Center"
                HorizontalAlignment="Center" Background="{DynamicResource Card}"
                CornerRadius="20" Padding="60,40" MaxWidth="900">
            <StackPanel>
                <TextBlock x:Name="ReplyCaption" FontSize="22" Foreground="{DynamicResource Dim}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ReplyText" FontSize="46" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="OfflineView" Visibility="Collapsed" Background="#B5A21B00">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="OfflineTitle" FontSize="52" FontWeight="Bold"
                           Foreground="#FFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="OfflineBody" FontSize="28" Foreground="#FFE9D5"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- A2 · incoming / monitor screen. -->
        <Grid x:Name="IncomingView" Visibility="Collapsed" Background="#000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="20,16,20,8">
                <StackPanel HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IncomingTitle" FontSize="32" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="#F2F5F8"/>
                        <!-- Seconds until the panel returns home. Tapping it stops the return
                             and leaves the live view up. -->
                        <Border x:Name="ReturnCountdown" Visibility="Collapsed" Cursor="Hand"
                                Margin="10,0,0,0" CornerRadius="10" Padding="12,6"
                                VerticalAlignment="Center" Background="#40FFFFFF"
                                MouseLeftButtonDown="OnReturnCountdownClick">
                            <TextBlock x:Name="ReturnCountdownText" FontSize="22"
                                       VerticalAlignment="Center" Foreground="#F2F5F8"/>
                        </Border>
                    </StackPanel>
                    <!-- Fixed-height purpose slot: a purpose that arrives later never moves the
                         layout (ring_then_purpose). -->
                    <Grid x:Name="PurposeSlot" Height="36" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="PurposeBadge" Visibility="Collapsed"
                                    Background="#2A3A4C" CornerRadius="8" Padding="12,6">
                                <StackPanel x:Name="PurposeBadgeContent"
                                            Orientation="Horizontal"/>
                            </Border>
                            <Border x:Name="LangBadge" Visibility="Collapsed" Background="#2A3A4C"
                                    CornerRadius="8" Padding="12,6" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconWorld}"
                                              Stroke="#F2F5F8" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="LangBadgeText" FontSize="18"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="#F2F5F8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="IncomingHint" FontSize="17" Foreground="#B6C1CC"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ClipToBounds="True">
                <MediaElement x:Name="IncomingH264" Stretch="Uniform" Visibility="Collapsed"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="False"/>
                <Image x:Name="IncomingLive" Stretch="Uniform"/>
                <TextBlock x:Name="IncomingNoVideo" FontSize="24" Foreground="#8A97A5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <WrapPanel x:Name="QuickReplyPanel" Grid.Row="2" Orientation="Horizontal"
                       HorizontalAlignment="Center" Margin="30,6,30,0" MaxWidth="1200"/>
            <WrapPanel x:Name="IncomingControlRow" Grid.Row="3" Orientation="Horizontal"
                       HorizontalAlignment="Center" Margin="20,10,20,18">
                <Button x:Name="MonitorButton" Style="{StaticResource ActionButton}"
                        BorderBrush="{DynamicResource Line}" Click="OnMonitorClick"/>
                <Button x:Name="AnswerButton" Style="{StaticResource ActionButton}"
                        FontWeight="Bold" Background="#187A3C" Foreground="#FFFFFF"
                        BorderBrush="#187A3C" Click="OnAnswerClick"/>
                <Button x:Name="MicButton" Style="{StaticResource ActionButton}"
                        BorderBrush="{DynamicResource Line}" Visibility="Collapsed"
                        Click="OnMicClick"/>
                <Button x:Name="OpenDoorButton" Style="{StaticResource ActionButton}"
                        Background="#B7791F" Foreground="#FFFFFF" BorderBrush="#B7791F"
                        Click="OnOpenDoorClick"/>
                <Button x:Name="QuickReplyToggle" Style="{StaticResource ActionButton}"
                        BorderBrush="{DynamicResource Line}" Click="OnQuickReplyToggleClick"/>
                <Button x:Name="IgnoreButton" Style="{StaticResource ActionButton}"
                        Foreground="#B6C1CC" BorderBrush="{DynamicResource Line}"
                        Click="OnIgnoreClick"/>
            </WrapPanel>
        </Grid>

        <Grid x:Name="InCallView" Visibility="Collapsed" Background="#000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,16,20,8" HorizontalAlignment="Left">
                <TextBlock x:Name="InCallTitle" FontSize="30" FontWeight="Bold"
                           Foreground="#F2F5F8"/>
                <Grid x:Name="InCallPurposeSlot" Height="34" Margin="0,6,0,0">
                    <Border x:Name="InCallPurposeBadge" Visibility="Collapsed"
                            Background="#2A3A4C" CornerRadius="8" Padding="12,6"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel x:Name="InCallPurposeContent" Orientation="Horizontal"/>
                    </Border>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="1" ClipToBounds="True">
                <MediaElement x:Name="PeerH264" Stretch="Uniform" Visibility="Collapsed"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="False"/>
                <Image x:Name="PeerVideo" Stretch="Uniform"/>
            </Grid>
            <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                       Margin="20,10,20,18">
                <Button x:Name="EndCallButton" Style="{StaticResource ActionButton}"
                        FontWeight="Bold" Background="{DynamicResource Danger}"
                        Foreground="{DynamicResource OnDanger}"
                        BorderBrush="{DynamicResource Danger}" Click="OnEndCallClick"/>
                <Button x:Name="InCallMicButton" Style="{StaticResource ActionButton}"
                        BorderBrush="{DynamicResource Line}" Visibility="Collapsed"
                        Click="OnMicClick"/>
                <Button x:Name="InCallOpenDoorButton" Style="{StaticResource ActionButton}"
                        Background="#B7791F" Foreground="#FFFFFF" BorderBrush="#B7791F"
                        Click="OnOpenDoorClick"/>
            </WrapPanel>
        </Grid>

        <!-- Shared overlay for both call screens: the announcement chip, this node's admin QR and
             the unobtrusive player statistics line. -->
        <Grid x:Name="CallOverlay" Visibility="Collapsed">
            <Border x:Name="NoticeChip" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,18,20,0" Cursor="Hand" CornerRadius="10" Padding="12,6"
                    Background="#C0141B22" BorderBrush="#3A4551" BorderThickness="1"
                    MouseLeftButtonDown="OnNoticeChipClick">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="NoticeChipDot" Width="9" Height="9" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{DynamicResource Warn}"
                             Visibility="Collapsed"/>
                    <TextBlock x:Name="NoticeChipText" FontSize="15" Foreground="#F2F5F8"/>
                </StackPanel>
            </Border>
            <Border x:Name="CallAdminQrCard" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="20,0,0,112" CornerRadius="8" Padding="6" Background="#C0141B22"
                    Cursor="Hand" MouseLeftButtonDown="OnWebAdminClick">
                <Image x:Name="CallAdminQrImage" Width="46" Height="46"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <Border x:Name="VideoStatsCard" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,112" CornerRadius="8" Padding="12,6" Background="#80101418"
                    Cursor="Hand" MouseLeftButtonDown="OnVideoStatsClick">
                <TextBlock x:Name="VideoStatsText" FontSize="11" Foreground="#8A97A5"
                           FontFamily="Consolas, Courier New"/>
            </Border>

            <Border x:Name="NoticePopover" Visibility="Collapsed" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,58,20,0" MaxWidth="440" CornerRadius="12"
                    Padding="16,14" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="NoticePopoverTarget" FontSize="13"
                               Foreground="{DynamicResource Dim}"/>
                    <TextBlock x:Name="NoticePopoverText" FontSize="18" TextWrapping="Wrap"
                               Margin="0,8,0,0" Foreground="{DynamicResource Fg}"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="NoticeEditButton" Style="{StaticResource ChipButton}"
                                BorderBrush="{DynamicResource Line}"
                                Click="OnNoticeEditClick"/>
                        <Button x:Name="NoticeClearButton" Style="{StaticResource ChipButton}"
                                BorderBrush="{DynamicResource Line}"
                                Click="OnNoticeClearClick"/>
                        <Button x:Name="NoticePopoverClose" Style="{StaticResource ChipButton}"
                                BorderBrush="{DynamicResource Line}"
                                Click="OnNoticePopoverCloseClick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Indoor proactive monitoring selects a door station without requiring a chime. -->
        <Grid x:Name="MonitorPickerView" Visibility="Collapsed" Background="#E6101418">
            <Border Background="{DynamicResource Card}" CornerRadius="20" Padding="38"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                <StackPanel>
                    <TextBlock x:Name="MonitorPickerTitle" FontSize="34" FontWeight="Bold"
                               Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="MonitorDoorList" Margin="0,24,0,18"/>
                    <Button x:Name="MonitorPickerClose" FontSize="24" Padding="34,12"
                            Background="{DynamicResource Card}" Foreground="{DynamicResource Fg}"
                            BorderBrush="{DynamicResource Line}" HorizontalAlignment="Center"
                            Click="OnMonitorPickerClose"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Full-screen call history, 50 rows per page, grouped by day. -->
        <Grid x:Name="HistoryView" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="26,20,26,6">
                <TextBlock x:Name="HistoryTitle" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Left" Foreground="{DynamicResource Fg}"/>
                <Button x:Name="HistoryCloseButton" Style="{StaticResource ChipButton}"
                        BorderBrush="{DynamicResource Line}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnHistoryCloseClick"/>
            </Grid>
            <WrapPanel x:Name="HistoryFilterRow" Grid.Row="1" Orientation="Horizontal"
                       Margin="26,0,26,8">
                <Button x:Name="HistoryFilterAll" Style="{StaticResource ChipButton}"
                        BorderBrush="{DynamicResource Line}" Margin="0,0,0,0"
                        Click="OnHistoryFilterClick" Tag="all"/>
                <Button x:Name="HistoryFilterMissed" Style="{StaticResource ChipButton}"
                        BorderBrush="{DynamicResource Line}" Click="OnHistoryFilterClick"
                        Tag="missed"/>
                <StackPanel x:Name="HistoryDoorFilters" Orientation="Horizontal"/>
                <Button x:Name="HistoryMarkSeenButton" Style="{StaticResource ChipButton}"
                        BorderBrush="{DynamicResource Line}" Margin="18,0,0,0"
                        Click="OnHistoryMarkSeenClick"/>
            </WrapPanel>
            <ScrollViewer Grid.Row="2" Margin="26,0,26,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryList"/>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="26,10,26,18" HorizontalAlignment="Center">
                <Button x:Name="HistoryMoreButton" Style="{StaticResource ChipButton}"
                        BorderBrush="{DynamicResource Line}" HorizontalAlignment="Center"
                        Click="OnHistoryMoreClick"/>
                <TextBlock x:Name="HistoryNote" FontSize="13" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Dim}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Canvas x:Name="ScreensaverView" Visibility="Collapsed" Background="#000000">
            <StackPanel x:Name="SaverBlock" Canvas.Left="120" Canvas.Top="120">
                <TextBlock x:Name="SaverClock" FontSize="64" FontWeight="Light"
                           Foreground="#39424C"/>
                <TextBlock x:Name="SaverDate" FontSize="20" Foreground="#242B33"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Canvas>

        <!-- Slide-to-trigger countdown; tapping cancel before zero tells core nothing. -->
        <Grid x:Name="SosCountdownView" Visibility="Collapsed" Background="#E68C0D0A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="SosCountdownText" FontSize="86" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <Button x:Name="SosCountdownCancel" FontSize="32" Padding="70,20"
                        Margin="0,44,0,0" Background="#FFFFFF" Foreground="#8C0D0A"
                        BorderThickness="0" HorizontalAlignment="Center"
                        Click="OnSosCountdownCancel"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="EmergencyView" Visibility="Collapsed" Background="#C62828">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EmergencyTitle" FontSize="110" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmergencyNote" FontSize="30" Foreground="#FFE3DE"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <Button x:Name="EmergencyCancelButton" FontSize="30" Padding="64,18"
                        Margin="0,64,0,0" Background="#7F1D1D" Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF" HorizontalAlignment="Center"
                        Click="OnEmergencyCancelClick"/>
            </StackPanel>
        </Grid>

        <Border x:Name="NightTint" Visibility="Collapsed" Background="#33FF2200"
                IsHitTestVisible="False"/>

        <!-- Persistent "not set up" banner; tapping it reopens onboarding (spec 5.0). -->
        <Border x:Name="PairBanner" Visibility="Collapsed" Background="{DynamicResource Notice}"
                Padding="16,12" VerticalAlignment="Top" Cursor="Hand"
                MouseLeftButtonDown="OnPairBannerClick">
            <TextBlock x:Name="PairBannerText" FontSize="20" FontWeight="Bold"
                       Foreground="#FFFFFF" HorizontalAlignment="Center"/>
        </Border>

        <pairing:PairingOnboardingView x:Name="PairingOverlay" Visibility="Collapsed"/>
    </Grid>
</Window>
