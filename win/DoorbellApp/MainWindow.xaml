<Window x:Class="DoorbellApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ドアホン" Background="{StaticResource Bg}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" Cursor="Arrow" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid ClipToBounds="True">
        <Image x:Name="ThemeBgImage" Stretch="UniformToFill" Visibility="Collapsed"
               IsHitTestVisible="False"/>

        <Grid x:Name="IdleView">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IdleShift"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,40,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="ClockText" FontSize="72" FontWeight="Light"
                           Foreground="{StaticResource Fg}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DateText" FontSize="26" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="CallButton" Style="{StaticResource BigButton}"
                        MinWidth="420" MinHeight="180" Click="OnCallClick"/>
                <Button x:Name="OpenMonitorButton" FontSize="22" Padding="28,12"
                        Margin="0,18,0,0" Background="{StaticResource Card}"
                        Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Dim}"
                        Visibility="Collapsed" Click="OnOpenMonitorClick"/>
                <TextBlock x:Name="TouchHint" FontSize="24" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,26,0,0"/>
                <Border x:Name="SosButton" Visibility="Collapsed" Background="#C0392B"
                        CornerRadius="16" Margin="0,44,0,0" Padding="56,18" Cursor="Hand"
                        HorizontalAlignment="Center"
                        MouseLeftButtonDown="OnSosDown" MouseLeftButtonUp="OnSosUp"
                        MouseLeave="OnSosLeave">
                    <StackPanel>
                        <TextBlock x:Name="SosText" FontSize="32" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SosHint" FontSize="14" Foreground="#FFD9D2"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="SosProgress" Height="6" Width="200" Margin="0,10,0,0"
                                     Minimum="0" Maximum="100" Value="0" Foreground="#FFFFFF"
                                     Background="#802A21" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="PurposeSection" Grid.Row="2" Visibility="Collapsed"
                        Margin="0,0,0,12">
                <TextBlock x:Name="PurposeHint" FontSize="20" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="20,0">
                    <UniformGrid x:Name="PurposeGrid" Columns="3" HorizontalAlignment="Center"/>
                </ScrollViewer>
            </StackPanel>

            <Grid Grid.Row="3" Margin="20,0,20,14">
                <StackPanel x:Name="LangBar" Orientation="Horizontal"
                            HorizontalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="NodeInfo" FontSize="14" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <Ellipse x:Name="MeshDot" Width="12" Height="12" Fill="#5DD39E"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Border Width="200" Height="200" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MouseLeftButtonDown="OnSecretCorner"/>
        </Grid>

        <Grid x:Name="CallingView" Visibility="Collapsed" Background="{StaticResource Bg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CallingText" FontSize="56" FontWeight="Bold"
                           Foreground="{StaticResource Fg}" HorizontalAlignment="Center"/>
                <Ellipse x:Name="Pulse" Width="140" Height="140" Margin="0,50"
                         Stroke="#4DA3FF" StrokeThickness="6" HorizontalAlignment="Center"/>
                <StackPanel x:Name="CallingPurposeSection" Visibility="Collapsed" Margin="20,0,20,24">
                    <TextBlock x:Name="CallingPurposeHint" FontSize="20"
                               Foreground="{StaticResource Dim}" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <UniformGrid x:Name="CallingPurposeGrid" Columns="3"
                                 HorizontalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CancelButton" FontSize="28" Padding="40,16"
                        Background="{StaticResource Card}" Foreground="{StaticResource Fg}"
                        BorderBrush="{StaticResource Dim}" Click="OnCancelClick"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ReplyBanner" Visibility="Collapsed" VerticalAlignment="Center"
                HorizontalAlignment="Center" Background="#243040" CornerRadius="20"
                Padding="60,40" MaxWidth="900">
            <StackPanel>
                <TextBlock x:Name="ReplyCaption" FontSize="22" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ReplyText" FontSize="46" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{StaticResource Fg}" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="OfflineView" Visibility="Collapsed" Background="#B5A21B00">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="OfflineTitle" FontSize="52" FontWeight="Bold"
                           Foreground="#FFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="OfflineBody" FontSize="28" Foreground="#FFE9D5"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <Grid x:Name="IncomingView" Visibility="Collapsed" Background="#000000">
            <MediaElement x:Name="IncomingH264" Stretch="Uniform" Visibility="Collapsed"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"/>
            <Image x:Name="IncomingLive" Stretch="Uniform"/>
            <TextBlock x:Name="IncomingNoVideo" FontSize="24" Foreground="{StaticResource Dim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Background="#C0141B22" CornerRadius="14" Padding="28,16"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24">
                <StackPanel>
                    <TextBlock x:Name="IncomingTitle" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource Fg}" Background="#0A0D12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="PurposeBadge" Visibility="Collapsed" Background="#2A3A4C"
                                CornerRadius="8" Padding="12,4">
                            <TextBlock x:Name="PurposeBadgeText" FontSize="20"
                                       Foreground="{StaticResource Fg}"/>
                        </Border>
                        <Border x:Name="LangBadge" Visibility="Collapsed" Background="#2A3A4C"
                                CornerRadius="8" Padding="12,4" Margin="10,0,0,0">
                            <TextBlock x:Name="LangBadgeText" FontSize="20"
                                       Foreground="{StaticResource Fg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="IncomingHint" FontSize="18" Foreground="{StaticResource Dim}"
                               Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <WrapPanel x:Name="QuickReplyPanel" Orientation="Horizontal"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="40,0,40,130" MaxWidth="1200"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,44">
                <Button x:Name="AnswerButton" FontSize="30" FontWeight="Bold" Padding="56,20"
                        Background="#187A3C" Foreground="#FFFFFF" BorderThickness="0"
                        Click="OnAnswerClick"/>
                <Button x:Name="MonitorButton" FontSize="30" Padding="44,20" Margin="24,0,0,0"
                        Background="{StaticResource Card}" Foreground="{StaticResource Fg}"
                        BorderBrush="{StaticResource Dim}" Click="OnMonitorClick"/>
                <Button x:Name="OpenDoorButton" FontSize="30" Padding="44,20" Margin="24,0,0,0"
                        Background="#B7791F" Foreground="#FFFFFF" BorderThickness="0"
                        Click="OnOpenDoorClick"/>
                <Button x:Name="IgnoreButton" FontSize="30" Padding="44,20" Margin="24,0,0,0"
                        Background="{StaticResource Card}" Foreground="{StaticResource Dim}"
                        BorderBrush="{StaticResource Dim}" Click="OnIgnoreClick"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="InCallView" Visibility="Collapsed" Background="#000000">
            <MediaElement x:Name="PeerH264" Stretch="Uniform" Visibility="Collapsed"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"/>
            <Image x:Name="PeerVideo" Stretch="Uniform"/>
            <Border Background="#C0141B22" CornerRadius="14" Padding="28,12"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24">
                <TextBlock x:Name="InCallTitle" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource Fg}"/>
            </Border>
            <Button x:Name="EndCallButton" FontSize="30" FontWeight="Bold" Padding="64,20"
                    Background="#C0392B" Foreground="#FFFFFF" BorderThickness="0"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,44"
                    Click="OnEndCallClick"/>
            <Button x:Name="InCallOpenDoorButton" FontSize="24" Padding="36,14"
                    Background="#B7791F" Foreground="#FFFFFF" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,50"
                    Click="OnOpenDoorClick"/>
        </Grid>

        <!-- Indoor proactive monitoring selects a door station without requiring a chime. -->
        <Grid x:Name="MonitorPickerView" Visibility="Collapsed" Background="#E6101418">
            <Border Background="{StaticResource Card}" CornerRadius="20" Padding="38"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                <StackPanel>
                    <TextBlock x:Name="MonitorPickerTitle" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource Fg}" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="MonitorDoorList" Margin="0,24,0,18"/>
                    <Button x:Name="MonitorPickerClose" FontSize="24" Padding="34,12"
                            Background="{StaticResource Card}" Foreground="{StaticResource Fg}"
                            BorderBrush="{StaticResource Dim}" HorizontalAlignment="Center"
                            Click="OnMonitorPickerClose"/>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="ScreensaverView" Visibility="Collapsed" Background="#000000">
            <StackPanel x:Name="SaverBlock" Canvas.Left="120" Canvas.Top="120">
                <TextBlock x:Name="SaverClock" FontSize="64" FontWeight="Light"
                           Foreground="#39424C"/>
                <TextBlock x:Name="SaverDate" FontSize="20" Foreground="#242B33"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Canvas>

        <Grid x:Name="EmergencyView" Visibility="Collapsed" Background="#C62828">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EmergencyTitle" FontSize="110" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmergencyNote" FontSize="30" Foreground="#FFE3DE"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <Button x:Name="EmergencyCancelButton" FontSize="30" Padding="64,18"
                        Margin="0,64,0,0" Background="#7F1D1D" Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF" HorizontalAlignment="Center"
                        Click="OnEmergencyCancelClick"/>
            </StackPanel>
        </Grid>

        <Border x:Name="NightTint" Visibility="Collapsed" Background="#33FF2200"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
