<Window x:Class="DoorbellApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pairing="clr-namespace:DoorbellApp.Pairing"
        xmlns:app="clr-namespace:DoorbellApp.Ui"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="ドアホン" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" Cursor="Arrow" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="WrappedLabel">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>
        <Style x:Key="VisitorPrimaryAction" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="MaxWidth" Value="620"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate" Value="{StaticResource WrappedLabel}"/>
        </Style>
        <Style x:Key="VisitorSecondaryAction" TargetType="Button"
               BasedOn="{StaticResource BigSecondaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="MaxWidth" Value="620"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate" Value="{StaticResource WrappedLabel}"/>
        </Style>
        <!-- End call: the same full-width slot in the fixed negative role. -->
        <Style x:Key="VisitorNegativeAction" TargetType="Button"
               BasedOn="{StaticResource SemanticButton}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="MaxWidth" Value="620"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate" Value="{StaticResource WrappedLabel}"/>
        </Style>
        <!-- Rows of the call lists: full width, touch height, the Fluent list item visuals. -->
        <Style x:Key="CallListItem" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Image x:Name="ThemeBgImage" Stretch="UniformToFill" Visibility="Collapsed"
               IsHitTestVisible="False"/>
        <!-- The scrim that makes text and cards read over a bright wallpaper. It is a sibling
             drawn immediately after the picture and before every screen, so it darkens the
             picture and never the door tiles, the call list or any other plate above it.
             Colour and opacity come from display.theme.backdrop. -->
        <Border x:Name="ThemeBackdrop" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Grid x:Name="IdleView" PreviewMouseLeftButtonDown="OnIdlePreviewDown">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IdleShift"/>
            </Grid.RenderTransform>

            <!-- Hidden 7-tap corner. It only marks the area: IdleView counts the taps while
                 they tunnel, so whatever is drawn over the corner still takes its own taps. -->
            <Border x:Name="SecretCorner" Width="48" Height="48" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>

            <!-- B · door-station visitor screen: top bar, notice, purpose grid, then the fixed
                 bottom action zone with the full-width Call button (VisitorCallBlock). -->
            <Grid x:Name="VisitorHome" Margin="20,18,20,18" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="VisitorContentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar (ui-guidelines 4, Visitor): door name left, clock centre, language
                     switch right. Compact windows move the clock to a second line. -->
                <Grid x:Name="VisitorTopBar" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VisitorDoorName" Grid.Column="0" FontSize="22"
                               FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnSurface}" Margin="0,0,12,0"/>
                    <StackPanel x:Name="VisitorClockBlock" Grid.Column="1"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="ClockText" FontSize="76" FontWeight="Light"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                        <TextBlock x:Name="DateText" FontSize="24" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="LangBar" Grid.Column="2" Orientation="Horizontal"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="12,0,0,0" Visibility="Collapsed"/>
                </Grid>

                <Border x:Name="VisitorNoticeCard" Grid.Row="1"
                        Visibility="Collapsed" Margin="0,16,0,0" CornerRadius="4"
                        Padding="16,12" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Notice}" BorderThickness="1,1,1,4"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="VisitorNoticeText" FontSize="22" TextWrapping="Wrap"
                               Foreground="{DynamicResource OnSurface}"/>
                </Border>

                <TextBlock x:Name="TouchHint" Grid.Row="2" FontSize="20"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>

                <StackPanel x:Name="PurposeSection" Grid.Row="3" Visibility="Collapsed"
                            Margin="0,16,0,8">
                    <TextBlock x:Name="PurposeHint" FontSize="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="PurposeGrid" Columns="3" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Grid x:Name="VisitorFooter" Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock x:Name="VisitorVersionLine" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="VisitorSosHost" Grid.Row="5" Margin="0,16,0,0"/>
                    </Grid>
                </ScrollViewer>
                <StackPanel x:Name="VisitorCallBlock" Grid.Row="1">
                    <TextBlock x:Name="VisitorStatus" Visibility="Collapsed" FontSize="22"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource Fg}" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="CallButton" Style="{StaticResource VisitorPrimaryAction}" Click="OnCallClick"/>
                </StackPanel>
            </Grid>

            <!-- A · indoor panel. A Fluent NavigationView carries the destinations (Home,
                 History, Monitor, Settings): expanded pane from 900 px, icon rail from 600 px,
                 hamburger below that. Home is the dashboard over the wallpaper; History is an
                 opaque page. Item labels and icons are set in MainWindow.Navigation.cs. -->
            <Grid x:Name="DashboardHome" Visibility="Collapsed">
                <ui:NavigationView x:Name="HomeNav" PaneDisplayMode="Auto"
                                   CompactModeThresholdWidth="600" ExpandedModeThresholdWidth="900"
                                   OpenPaneLength="240" IsSettingsVisible="False"
                                   IsBackButtonVisible="Collapsed"
                                   ItemInvoked="OnHomeNavInvoked">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem x:Name="NavHome" MinHeight="48"/>
                        <!-- History carries the unread missed-call count beside its label. -->
                        <ui:NavigationViewItem x:Name="NavHistory" MinHeight="48">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NavHistoryLabel" VerticalAlignment="Center"/>
                                <Border x:Name="NavHistoryBadge" Visibility="Collapsed"
                                        Background="{DynamicResource Negative}" CornerRadius="10"
                                        MinWidth="20" Height="20" Padding="6,0,6,0"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavHistoryBadgeText" FontSize="12"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnNegative}"/>
                                </Border>
                            </StackPanel>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="OpenMonitorButton" MinHeight="48"
                                               Visibility="Collapsed"/>
                        <ui:NavigationViewItemSeparator/>
                        <ui:NavigationViewItem x:Name="AdminEntryButton" MinHeight="48"/>
                    </ui:NavigationView.MenuItems>
                    <Grid>
                        <Grid x:Name="DashboardPage" Margin="24,16,24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: clock left; announcement command and the device status
                                 card right. -->
                            <Grid Grid.Row="0">
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DashClock" FontSize="66" FontWeight="Light"
                                                   Foreground="{DynamicResource Fg}"/>
                                        <TextBlock x:Name="DashClockSeconds" FontSize="28" FontWeight="Light"
                                                   Margin="6,0,0,12" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource Dim}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DashDate" FontSize="18"
                                               Foreground="{DynamicResource Dim}" Margin="2,0,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <WrapPanel x:Name="DashboardChips" Orientation="Horizontal"
                                               HorizontalAlignment="Right">
                                        <Button x:Name="NoticeGlobalButton" Style="{StaticResource ChipButton}"
                                                Click="OnGlobalNoticeClick"/>
                                    </WrapPanel>
                                    <!-- Status card: cluster size, door stations and indoor panels
                                         online, battery. Tapping it opens Add device. -->
                                    <Border x:Name="MembershipStatus" Visibility="Collapsed" Cursor="Hand"
                                            Background="{DynamicResource Pill}" CornerRadius="4"
                                            Padding="14,10" BorderBrush="{DynamicResource PlateLine}"
                                            BorderThickness="1" Margin="0,8,0,0" MinHeight="44"
                                            HorizontalAlignment="Right"
                                            MouseLeftButtonDown="OnMembershipClick">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel x:Name="ClusterCounter" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconTopologyStar3}" Stroke="{DynamicResource Dim}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                                <TextBlock x:Name="ClusterCountText" FontSize="15"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Fg}"/>
                                                <TextBlock x:Name="ClusterOnlineText" FontSize="15"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Ok}"/>
                                            </StackPanel>
                                            <Rectangle Width="1" Margin="12,2,12,2" Fill="{DynamicResource PlateLine}"/>
                                            <StackPanel x:Name="DoorCounter" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconDoor}" Stroke="{DynamicResource Dim}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                                <TextBlock x:Name="DoorCounterLabel" FontSize="15"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Dim}"/>
                                                <TextBlock x:Name="DoorCountText" FontSize="15" FontWeight="Bold"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Fg}"/>
                                            </StackPanel>
                                            <Rectangle Width="1" Margin="12,2,12,2" Fill="{DynamicResource PlateLine}"/>
                                            <StackPanel x:Name="PanelCounter" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconDeviceTablet}" Stroke="{DynamicResource Dim}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                                <TextBlock x:Name="PanelCounterLabel" FontSize="15"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Dim}"/>
                                                <TextBlock x:Name="PanelCountText" FontSize="15" FontWeight="Bold"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Fg}"/>
                                            </StackPanel>
                                            <StackPanel x:Name="BatteryCounter" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Visibility="Collapsed">
                                                <Rectangle Width="1" Margin="12,2,12,2" Fill="{DynamicResource PlateLine}"/>
                                                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                                    <Path x:Name="BatteryIcon" Data="{StaticResource IconBattery}"
                                                          Stroke="{DynamicResource Dim}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>
                                                </Viewbox>
                                                <TextBlock x:Name="BatteryText" FontSize="15"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Fg}"/>
                                            </StackPanel>
                                            <Ellipse x:Name="MeshDot" Width="9" Height="9"
                                                     Fill="{DynamicResource Ok}" Margin="12,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Unread missed calls: a status bar in the Fluent InfoBar layout
                                 (severity stripe, icon, message, action). ModernWpf 0.9.6 ships
                                 no InfoBar control, so it is assembled from stock elements. Its
                                 action opens History. -->
                            <Border x:Name="MissedBadge" Grid.Row="1" Visibility="Collapsed"
                                    Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                                    BorderBrush="{DynamicResource Warning}" BorderThickness="4,1,1,1"
                                    Padding="12,6" MinHeight="48">
                                <DockPanel>
                                    <Button x:Name="MissedBadgeAction" DockPanel.Dock="Right"
                                            MinHeight="44" MinWidth="44" Margin="12,0,0,0"
                                            VerticalAlignment="Center" Click="OnOpenHistoryClick"/>
                                    <Viewbox DockPanel.Dock="Left" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Path Data="{StaticResource IconCalendarTime}"
                                              Stroke="{DynamicResource Warning}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="MissedBadgeText" FontSize="15"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg}"/>
                                </DockPanel>
                            </Border>

                            <TextBlock x:Name="DoorsSectionTitle" Grid.Row="2" Margin="4,16,0,8"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg}"/>

                            <!-- The door tiles take the whole page; call history has its own
                                 destination in the navigation pane. -->
                            <ScrollViewer x:Name="DoorTilesPanel" Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <UniformGrid x:Name="DoorTileGrid" Columns="2" VerticalAlignment="Top"/>
                            </ScrollViewer>

                            <Grid x:Name="DashboardFooter" Grid.Row="4" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Width is reserved at runtime from the SOS slider's real footprint. -->
                                    <ColumnDefinition x:Name="DashboardSosColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <!-- Footer card: admin QR and address, then the name, versions
                                     and battery line. -->
                                <Border x:Name="AdminLinkCard" Grid.Column="0" Cursor="Hand"
                                        app:Frost.Enabled="True" CornerRadius="8" ClipToBounds="True"
                                        BorderBrush="{DynamicResource PlateLine}" BorderThickness="1"
                                        MinWidth="320" MaxWidth="560" HorizontalAlignment="Left"
                                        MouseLeftButtonDown="OnWebAdminClick">
                                    <Border Background="{DynamicResource Plate}" CornerRadius="8"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FFFFFF" CornerRadius="4" Padding="3">
                                                <Image x:Name="AdminQrImage" Width="66" Height="66"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="AdminLinkTitle" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Fg}"/>
                                                    <TextBlock x:Name="AdminAddressCount" FontSize="14"
                                                               Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                               Foreground="{DynamicResource Dim}"/>
                                                </StackPanel>
                                                <Border Background="{DynamicResource Row}" CornerRadius="4"
                                                        Padding="12,6" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="AdminUrlText" FontSize="14"
                                                               Foreground="{DynamicResource Fg}"/>
                                                </Border>
                                                <TextBlock x:Name="NodeInfo" FontSize="13" Margin="0,4,0,0"
                                                           TextWrapping="Wrap" MaxWidth="440"
                                                           Foreground="{DynamicResource Dim}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- History page: filters, then the list (and the detail beside it when
                             expanded), 50 rows per page, grouped by day. -->
                        <Grid x:Name="HistoryView" Visibility="Collapsed" Background="{DynamicResource Bg}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HistoryHeader" Grid.Row="0" Margin="24,16,24,8">
                                <TextBlock x:Name="HistoryTitle" FontSize="28" FontWeight="SemiBold"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg}"/>
                                <Button x:Name="HistoryCloseButton" Style="{StaticResource ChipButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="OnHistoryCloseClick"/>
                            </Grid>
                            <WrapPanel x:Name="HistoryFilterRow" Grid.Row="1" Orientation="Horizontal"
                                       Margin="24,0,24,8">
                                <Button x:Name="HistoryFilterAll" Style="{StaticResource ChipButton}"
                                        Margin="0,0,0,0"
                                        Click="OnHistoryFilterClick" Tag="all"/>
                                <Button x:Name="HistoryFilterMissed" Style="{StaticResource ChipButton}"
                                        Click="OnHistoryFilterClick"
                                        Tag="missed"/>
                                <StackPanel x:Name="HistoryDoorFilters" Orientation="Horizontal"/>
                                <Button x:Name="HistoryMarkSeenButton" Style="{StaticResource ChipButton}"
                                        Margin="18,0,0,0"
                                        Click="OnHistoryMarkSeenClick"/>
                            </WrapPanel>
                            <!-- Expanded: list left, detail right. Compact/medium: the detail
                                 replaces the list (drill-down) with a back action. -->
                            <Grid x:Name="HistoryBody" Grid.Row="2" Margin="24,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HistoryListColumn" Width="*"/>
                                    <ColumnDefinition x:Name="HistoryDetailColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <ListView x:Name="HistoryList" Background="Transparent"
                                          BorderThickness="0" SelectionMode="Single"
                                          ItemContainerStyle="{StaticResource CallListItem}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.PanningMode="VerticalOnly"/>
                                <Border x:Name="HistoryDetailPane" Grid.Column="1" Visibility="Collapsed"
                                        Margin="16,8,0,8" CornerRadius="8" Padding="16"
                                        Style="{StaticResource CardBorder}">
                                    <DockPanel>
                                        <Button x:Name="HistoryDetailBack" DockPanel.Dock="Top"
                                                Style="{StaticResource ChipButton}" MinHeight="44"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,12" Click="OnHistoryDetailBackClick"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="HistoryDetail"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="3" Margin="24,10,24,18" HorizontalAlignment="Center">
                                <Button x:Name="HistoryMoreButton" Style="{StaticResource ChipButton}"
                                        Margin="0" HorizontalAlignment="Center"
                                        Click="OnHistoryMoreClick"/>
                                <TextBlock x:Name="HistoryNote" FontSize="13" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Dim}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ui:NavigationView>
            </Grid>

            <!-- SOS trigger (semantic id "sos.trigger"): a compact outlined secondary button.
                 A tap only opens the confirmation card below; nothing is sent from here. -->
            <Button x:Name="SosButton" Visibility="Collapsed"
                    Style="{StaticResource SosTriggerButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,16" Click="OnSosTriggerClick"/>

        </Grid>

        <Grid x:Name="CallingView" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" Margin="20,18,20,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CallingText" FontSize="42" FontWeight="Bold" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="CallingDetail" FontSize="22" TextWrapping="Wrap" Margin="0,12,0,0"
                               TextAlignment="Center" Foreground="{DynamicResource Dim}"/>
                    <Ellipse x:Name="Pulse" Width="100" Height="100" Margin="0,24"
                             Stroke="{DynamicResource Accent}" StrokeThickness="6" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="CallingPurposeSection" Visibility="Collapsed" Margin="0,0,0,24">
                        <TextBlock x:Name="CallingPurposeHint" FontSize="20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dim}" TextAlignment="Center" Margin="0,0,0,8"/>
                        <UniformGrid x:Name="CallingPurposeGrid" Columns="3" HorizontalAlignment="Stretch"/>
                        <Button x:Name="CallingPurposeSkip" MinHeight="72" FontSize="22" Padding="16,10"
                                Margin="0,12,0,0" Click="OnPurposeSkipClick"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="CancelButton" Grid.Row="1" Style="{StaticResource VisitorSecondaryAction}"
                    Margin="20,12,20,18" Click="OnCancelClick"/>
        </Grid>

        <Border x:Name="ReplyBanner" Visibility="Collapsed" VerticalAlignment="Center"
                HorizontalAlignment="Center" Style="{StaticResource CardBorder}"
                CornerRadius="8" Padding="60,40" MaxWidth="900">
            <StackPanel>
                <TextBlock x:Name="ReplyCaption" FontSize="22" Foreground="{DynamicResource Dim}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ReplyText" FontSize="46" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="OfflineView" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" Margin="20,18,20,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OfflineTitle" FontSize="42" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg}" TextAlignment="Center"/>
                    <TextBlock x:Name="OfflineBody" FontSize="24" Foreground="{DynamicResource Dim}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="OfflineAction" Grid.Row="1" Style="{StaticResource VisitorSecondaryAction}"
                    Margin="20,12,20,18" IsEnabled="False"/>
        </Grid>

        <!-- A2 · incoming / monitor screen. -->
        <!-- Incoming / monitor screen, after the iPad 1 layout: title with the return countdown at
             the far right, the video in a rounded black frame that takes the door camera's aspect,
             quick replies, then one control row of icon buttons. Surfaces follow the appearance. -->
        <!-- Incoming / monitor screen (ui-guidelines 4, Incoming call). Portrait and narrow
             windows: header, video, then the action zone at the bottom. Expanded landscape: the
             video keeps at least 60% of the width on the left and the action zone is a fixed
             column on the right (MainWindow.Layout.cs). Primary row: Answer (positive, largest),
             Reply, Ignore; secondary row: Monitor, Unlock, Mic. -->
        <Grid x:Name="IncomingView" Visibility="Collapsed" Background="{DynamicResource Bg}"
              PreviewMouseDown="OnLiveViewInput" PreviewTouchDown="OnLiveViewInput">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IncomingStageColumn" Width="*"/>
                <ColumnDefinition x:Name="IncomingActionColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="24,16,24,8">
                <StackPanel HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IncomingTitle" FontSize="30" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                        <!-- Seconds until the panel returns home. Tapping it stops the return
                             and leaves the live view up. -->
                        <Border x:Name="ReturnCountdown" Visibility="Collapsed" Cursor="Hand"
                                Margin="12,0,0,0" CornerRadius="4" Padding="12,6"
                                VerticalAlignment="Center" Background="{DynamicResource Pill}"
                                BorderBrush="{DynamicResource PlateLine}" BorderThickness="1"
                                MouseLeftButtonDown="OnReturnCountdownClick">
                            <TextBlock x:Name="ReturnCountdownText" FontSize="20"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                        </Border>
                    </StackPanel>
                    <!-- Fixed-height purpose slot: a purpose that arrives later never moves the
                         layout (ring_then_purpose). -->
                    <Grid x:Name="PurposeSlot" Height="36" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="PurposeBadge" Visibility="Collapsed"
                                    Background="{DynamicResource Pill}" CornerRadius="8" Padding="12,6"
                                    BorderBrush="{DynamicResource PlateLine}" BorderThickness="1">
                                <StackPanel x:Name="PurposeBadgeContent"
                                            Orientation="Horizontal"/>
                            </Border>
                            <Border x:Name="LangBadge" Visibility="Collapsed"
                                    Background="{DynamicResource Pill}" CornerRadius="8" Padding="12,6"
                                    BorderBrush="{DynamicResource PlateLine}" BorderThickness="1"
                                    Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconWorld}"
                                              Stroke="{DynamicResource Fg}" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="LangBadgeText" FontSize="17"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ConversationSummary" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="IncomingVisitQueue"/>
                    </ScrollViewer>
                    <WrapPanel x:Name="ConversationActions"/>
                    <TextBlock x:Name="IncomingHint" FontSize="16" Foreground="{DynamicResource Dim}"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="IncomingStage" Grid.Row="1" Margin="24,4,24,0">
                <Border x:Name="IncomingVideoFrame" CornerRadius="4" Background="#000000"
                        ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <app:ZoomPanHost x:Name="IncomingZoom">
                    <Grid x:Name="IncomingVideoArea" ClipToBounds="True">
                        <MediaElement x:Name="IncomingH264" Stretch="Uniform" Visibility="Collapsed"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      ScrubbingEnabled="False"/>
                        <Image x:Name="IncomingLive" Stretch="Uniform"/>
                        <!-- Core-decoded H.264 (H264LiveStreamer); shown once the first frame lands. -->
                        <Image x:Name="IncomingH264Image" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="IncomingNoVideo" FontSize="22"
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    </app:ZoomPanHost>
                </Border>
            </Grid>
            <!-- Fixed action zone. In live view (monitor only) it floats over the video on a
                 plate and hides after 4 s without input; a tap brings it back. -->
            <Border x:Name="IncomingActionZone" Grid.Row="2" Grid.ColumnSpan="2"
                    Margin="16,12,16,16" Padding="8" CornerRadius="8"
                    Background="Transparent">
                <StackPanel x:Name="IncomingActionStack">
                    <UniformGrid x:Name="IncomingPrimaryRow" Rows="1" HorizontalAlignment="Stretch">
                        <Button x:Name="AnswerButton" Style="{StaticResource SemanticActionButton}"
                                Background="{DynamicResource Positive}"
                                Foreground="{DynamicResource OnPositive}"
                                BorderBrush="{DynamicResource Positive}"
                                MinHeight="88" FontSize="20" PreviewMouseDown="OnConversationActionDown" Click="OnAnswerClick"/>
                        <Button x:Name="QuickReplyToggle" Style="{StaticResource ActionButton}"
                                Click="OnQuickReplyToggleClick"/>
                        <Button x:Name="IgnoreButton" Style="{StaticResource ActionButton}"
                                Foreground="{DynamicResource Negative}"
                                BorderBrush="{DynamicResource Negative}"
                                Click="OnIgnoreClick"/>
                    </UniformGrid>
                    <WrapPanel x:Name="IncomingSecondaryRow" Orientation="Horizontal"
                               HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="MonitorButton" Style="{StaticResource ActionButton}"
                                MinHeight="56" Click="OnMonitorClick"/>
                        <Button x:Name="OpenDoorButton" Style="{StaticResource ActionButton}"
                                MinHeight="56" Foreground="{DynamicResource Warning}"
                                BorderBrush="{DynamicResource Warning}" PreviewMouseDown="OnConversationActionDown" Click="OnOpenDoorClick"/>
                        <Button x:Name="MicButton" Style="{StaticResource ActionButton}"
                                MinHeight="56" Visibility="Collapsed" Click="OnMicClick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- Quick-reply sheet: bottom sheet (compact/medium) or side sheet (expanded). The
                 call screen stays underneath and alive; one tap sends. -->
            <Border x:Name="QuickReplySheet" Grid.RowSpan="3" Grid.ColumnSpan="2"
                    Visibility="Collapsed" VerticalAlignment="Bottom"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="8,8,0,0" Padding="16,12,16,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,0,0,8">
                        <TextBlock x:Name="QuickReplySheetTitle" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,60,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                        <Button x:Name="QuickReplySheetClose" HorizontalAlignment="Right"
                                Style="{StaticResource ChipButton}" Margin="0"
                                MinWidth="48" MinHeight="48" Click="OnQuickReplySheetClose"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <WrapPanel x:Name="QuickReplyPanel" Orientation="Horizontal"
                                   HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- In call: same zones as the incoming screen; End sits where Answer was. -->
        <Grid x:Name="InCallView" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InCallStageColumn" Width="*"/>
                <ColumnDefinition x:Name="InCallActionColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="InCallHeaderScroll" Grid.Row="0" Grid.ColumnSpan="2" Margin="24,16,24,8"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock x:Name="InCallTitle" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                <Grid x:Name="InCallPurposeSlot" Height="34" Margin="0,6,0,0">
                    <Border x:Name="InCallPurposeBadge" Visibility="Collapsed"
                            Background="{DynamicResource Pill}" CornerRadius="8" Padding="12,6"
                            BorderBrush="{DynamicResource PlateLine}" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel x:Name="InCallPurposeContent" Orientation="Horizontal"/>
                    </Border>
                </Grid>
            </StackPanel>
            </ScrollViewer>
            <Grid x:Name="InCallStage" Grid.Row="1" Margin="24,4,24,0">
                <Border CornerRadius="4" Background="#000000" ClipToBounds="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <app:ZoomPanHost x:Name="InCallZoom">
                    <Grid ClipToBounds="True">
                        <MediaElement x:Name="PeerH264" Stretch="Uniform" Visibility="Collapsed"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      ScrubbingEnabled="False"/>
                        <Image x:Name="PeerVideo" Stretch="Uniform"/>
                        <Image x:Name="PeerH264Image" Stretch="Uniform" Visibility="Collapsed"/>
                    </Grid>
                    </app:ZoomPanHost>
                </Border>
            </Grid>
            <StackPanel x:Name="InCallActionZone" Grid.Row="2" Grid.ColumnSpan="2"
                        Margin="24,12,24,16">
                <Button x:Name="EndCallButton" Style="{StaticResource VisitorNegativeAction}"
                        Background="{DynamicResource Negative}" Foreground="{DynamicResource OnNegative}"
                        BorderBrush="{DynamicResource Negative}" Click="OnEndCallClick"/>
                <WrapPanel x:Name="InCallSecondaryRow" Orientation="Horizontal"
                           HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="InCallMicButton" Style="{StaticResource ActionButton}"
                            MinHeight="56" Visibility="Collapsed" Click="OnMicClick"/>
                    <Button x:Name="InCallOpenDoorButton" Style="{StaticResource ActionButton}"
                            MinHeight="56" Foreground="{DynamicResource Warning}"
                            BorderBrush="{DynamicResource Warning}" Click="OnOpenDoorClick"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- Shared overlay for both call screens: the announcement chip, this node's admin QR and
             the unobtrusive player statistics line. -->
        <Grid x:Name="CallOverlay" Visibility="Collapsed">
            <Border x:Name="NoticeChip" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,20,24,0" Cursor="Hand" CornerRadius="4" Padding="14,8"
                    Background="{DynamicResource Pill}" BorderBrush="{DynamicResource PlateLine}"
                    BorderThickness="1" MouseLeftButtonDown="OnNoticeChipClick">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource Fg}"
                              StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                    <Ellipse x:Name="NoticeChipDot" Width="9" Height="9" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{DynamicResource Warn}"
                             Visibility="Collapsed"/>
                    <TextBlock x:Name="NoticeChipText" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Fg}"/>
                </StackPanel>
            </Border>
            <Border x:Name="CallAdminQrCard" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="24,0,0,118" CornerRadius="8" Padding="5" Background="#FFFFFF"
                    Cursor="Hand" MouseLeftButtonDown="OnWebAdminClick">
                <Image x:Name="CallAdminQrImage" Width="44" Height="44"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <!-- Player statistics: a quiet monospace line in the bottom-right corner, never over
                 the picture's centre; tap to hide. -->
            <Border x:Name="VideoStatsCard" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,118" CornerRadius="8" Padding="12,6"
                    Background="{DynamicResource Pill}" BorderBrush="{DynamicResource PlateLine}"
                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnVideoStatsClick">
                <TextBlock x:Name="VideoStatsText" FontSize="11" Foreground="{DynamicResource Dim}"
                           FontFamily="Consolas, Courier New"/>
            </Border>

            <Border x:Name="NoticePopover" Visibility="Collapsed" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,58,20,0" MaxWidth="440" CornerRadius="8"
                    Padding="16,14" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock x:Name="NoticePopoverTarget" FontSize="13"
                               Foreground="{DynamicResource Dim}"/>
                    <TextBlock x:Name="NoticePopoverText" FontSize="18" TextWrapping="Wrap"
                               Margin="0,8,0,0" Foreground="{DynamicResource Fg}"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="NoticeEditButton" Style="{StaticResource ChipButton}"
                                Click="OnNoticeEditClick"/>
                        <Button x:Name="NoticeClearButton" Style="{StaticResource ChipButton}"
                                Click="OnNoticeClearClick"/>
                        <Button x:Name="NoticePopoverClose" Style="{StaticResource ChipButton}"
                                Click="OnNoticePopoverCloseClick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Indoor proactive monitoring selects a door station without requiring a chime. -->
        <Grid x:Name="MonitorPickerView" Visibility="Collapsed" Background="#99000000">
            <Border Style="{StaticResource CardBorder}" CornerRadius="8" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                <StackPanel>
                    <TextBlock x:Name="MonitorPickerTitle" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="MonitorDoorList" Margin="0,24,0,18"/>
                    <Button x:Name="MonitorPickerClose" FontSize="20" Padding="34,12"
                            MinHeight="48" HorizontalAlignment="Center"
                            Click="OnMonitorPickerClose"/>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="ScreensaverView" Visibility="Collapsed" Background="#000000">
            <StackPanel x:Name="SaverBlock" Canvas.Left="120" Canvas.Top="120">
                <TextBlock x:Name="SaverClock" FontSize="64" FontWeight="Light"
                           Foreground="#D9D9D9"/>
                <TextBlock x:Name="SaverDate" FontSize="20" Foreground="#D9D9D9"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="SaverHint" FontSize="28" FontWeight="SemiBold"
                           Foreground="#FFFFFF" TextWrapping="Wrap" MaxWidth="600"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Canvas>

        <!-- SOS confirmation (ui-guidelines 4, SOS): opened by the trigger, it says what will
             happen and takes a second, different gesture: sliding the control end to end. A
             keyboard or screen reader uses "Send SOS", which is never the default focus. It
             closes by itself after 10 s without input. -->
        <Grid x:Name="SosConfirmView" Visibility="Collapsed" Background="#99000000"
              PreviewMouseDown="OnSosConfirmInput" PreviewTouchDown="OnSosConfirmInput"
              PreviewKeyDown="OnSosConfirmInput">
            <Border Style="{StaticResource CardBorder}" CornerRadius="8" Padding="24,20"
                    MaxWidth="520" Margin="16" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="SosConfirmTitle" FontSize="24" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="SosConfirmBody" FontSize="16" TextWrapping="Wrap"
                               Margin="0,8,0,0" Foreground="{DynamicResource Dim}"/>
                    <Border Background="{DynamicResource Danger}" CornerRadius="28" Height="62"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,20,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Margin="62,6,16,6">
                                <TextBlock x:Name="SosText" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource OnDanger}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="SosHint" FontSize="13" Opacity="0.85"
                                           Foreground="{DynamicResource OnDanger}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <app:SosSlider x:Name="SosSlide" Style="{StaticResource SosTrack}"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SosConfirmSend" Style="{StaticResource SosTriggerButton}"
                                HorizontalAlignment="Left" Click="OnSosConfirmSend"/>
                        <Button x:Name="SosConfirmCancel" Grid.Column="1"
                                Style="{StaticResource ChipButton}" Margin="12,0,0,0"
                                MinWidth="120" Click="OnSosConfirmCancel"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Slide-to-trigger countdown; tapping cancel before zero tells core nothing. -->
        <Grid x:Name="SosCountdownView" Visibility="Collapsed" Background="#E68C0D0A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="SosCountdownText" FontSize="86" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <Button x:Name="SosCountdownCancel" Style="{StaticResource SemanticButton}"
                        FontSize="32" Padding="70,20"
                        Margin="0,44,0,0" Background="#FFFFFF" Foreground="#8C0D0A"
                        HorizontalAlignment="Center"
                        Click="OnSosCountdownCancel"/>
            </StackPanel>
        </Grid>

        <!-- Active SOS (ui-guidelines 4, SOS): full-screen negative overlay above every other
             layer (ZIndex), source and time, and one Clear action that needs a deliberate long
             press; keyboard users get a confirmation instead. Colors come from the Core event. -->
        <Grid x:Name="EmergencyView" Visibility="Collapsed" Background="{DynamicResource Negative}"
              Panel.ZIndex="1000">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1100">
                <TextBlock x:Name="EmergencyTitle" FontSize="110" FontWeight="Bold"
                           Foreground="{DynamicResource OnNegative}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="EmergencySource" FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnNegative}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="EmergencyNote" FontSize="30" Foreground="{DynamicResource OnNegative}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,18,0,0"/>
                <Button x:Name="EmergencyCancelButton" Style="{StaticResource SemanticButton}"
                        BorderThickness="2" FontSize="30" Padding="64,18" Margin="0,56,0,0"
                        MinHeight="88" MinWidth="420" HorizontalAlignment="Center"
                        Background="#7F1D1D" Foreground="#FFFFFF" BorderBrush="#FFFFFF"
                        Click="OnEmergencyCancelClick"/>
                <!-- Clear confirmation: the same slide as arming, then the admin rules. -->
                <StackPanel x:Name="EmergencyClearPanel" Visibility="Collapsed"
                            Margin="0,24,0,0" HorizontalAlignment="Center" MinWidth="420"
                            MaxWidth="520">
                    <TextBlock x:Name="EmergencyClearHint" FontSize="20"
                               Foreground="{DynamicResource OnNegative}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <Border Background="#33000000" CornerRadius="28" Height="62"
                            BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,16,0,0">
                        <Grid>
                            <TextBlock x:Name="EmergencyClearSlideText" FontSize="17"
                                       FontWeight="Bold" Foreground="#FFFFFF"
                                       IsHitTestVisible="False" Margin="62,6,16,6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <app:SosSlider x:Name="EmergencyClearSlide"
                                           Style="{StaticResource SosTrack}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Button x:Name="EmergencyClearConfirm" Style="{StaticResource ChipButton}"
                                Margin="0" Click="OnEmergencyClearConfirm"/>
                        <Button x:Name="EmergencyClearBack" Style="{StaticResource ChipButton}"
                                Margin="12,0,0,0" Click="OnEmergencyClearBack"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="NightTint" Visibility="Collapsed" Background="#33FF2200"
                IsHitTestVisible="False"/>

        <!-- Persistent "not set up" banner; tapping it reopens onboarding (spec 5.0). -->
        <Border x:Name="PairBanner" Visibility="Collapsed" Background="{DynamicResource Notice}"
                Padding="16,12" VerticalAlignment="Top" Cursor="Hand"
                MouseLeftButtonDown="OnPairBannerClick">
            <TextBlock x:Name="PairBannerText" FontSize="20" FontWeight="Bold"
                       Foreground="#FFFFFF" HorizontalAlignment="Center"/>
        </Border>

        <pairing:PairingOnboardingView x:Name="PairingOverlay" Visibility="Collapsed"/>
    </Grid>
</Window>
