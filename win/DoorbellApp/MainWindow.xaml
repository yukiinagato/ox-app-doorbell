<Window x:Class="DoorbellApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ドアホン" Background="{StaticResource Bg}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" Cursor="Arrow" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid>
        <!-- ============ 待機 ============ -->
        <!-- 焼付対策: コンテナ全体を pixel_shift_s 毎に ±8px 平行移動する (IdleShift) -->
        <Grid x:Name="IdleView">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IdleShift"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,60,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="ClockText" FontSize="72" FontWeight="Light"
                           Foreground="{StaticResource Fg}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DateText" FontSize="26" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="CallButton" Style="{StaticResource BigButton}"
                        MinWidth="420" MinHeight="180" Click="OnCallClick"/>
                <TextBlock x:Name="TouchHint" FontSize="24" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,26,0,0"/>
                <!-- SOS: role が emergency.button_on_roles に含まれる時のみ表示。
                     長押し hold_to_trigger_s 秒で発報 (誤操作防止 — 進捗バー表示) -->
                <Border x:Name="SosButton" Visibility="Collapsed" Background="#C0392B"
                        CornerRadius="16" Margin="0,44,0,0" Padding="56,18" Cursor="Hand"
                        HorizontalAlignment="Center"
                        MouseLeftButtonDown="OnSosDown" MouseLeftButtonUp="OnSosUp"
                        MouseLeave="OnSosLeave">
                    <StackPanel>
                        <TextBlock x:Name="SosText" FontSize="32" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SosHint" FontSize="14" Foreground="#FFD9D2"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="SosProgress" Height="6" Width="200" Margin="0,10,0,0"
                                     Minimum="0" Maximum="100" Value="0" Foreground="#FFFFFF"
                                     Background="#802A21" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DockPanel Grid.Row="2" Margin="20,0,20,14" LastChildFill="False">
                <TextBlock x:Name="NodeInfo" FontSize="14" Foreground="{StaticResource Dim}"
                           DockPanel.Dock="Left"/>
                <Ellipse x:Name="MeshDot" Width="12" Height="12" Fill="#5DD39E"
                         DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- 隠し管理入口 (右上 200x200 を 5 秒内 7 連打) -->
            <Border Width="200" Height="200" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MouseLeftButtonDown="OnSecretCorner"/>
        </Grid>

        <!-- ============ 呼び出し中 ============ -->
        <Grid x:Name="CallingView" Visibility="Collapsed" Background="{StaticResource Bg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CallingText" FontSize="56" FontWeight="Bold"
                           Foreground="{StaticResource Fg}" HorizontalAlignment="Center"/>
                <Ellipse x:Name="Pulse" Width="140" Height="140" Margin="0,50"
                         Stroke="#4DA3FF" StrokeThickness="6" HorizontalAlignment="Center"/>
                <Button x:Name="CancelButton" FontSize="28" Padding="40,16"
                        Background="{StaticResource Card}" Foreground="{StaticResource Fg}"
                        BorderBrush="{StaticResource Dim}" Click="OnCancelClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ クイック返信バナー (最前面オーバーレイ) ============ -->
        <Border x:Name="ReplyBanner" Visibility="Collapsed" VerticalAlignment="Center"
                HorizontalAlignment="Center" Background="#243040" CornerRadius="20"
                Padding="60,40" MaxWidth="900">
            <StackPanel>
                <TextBlock x:Name="ReplyCaption" FontSize="22" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ReplyText" FontSize="46" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{StaticResource Fg}" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============ オフライン ============ -->
        <Border x:Name="OfflineView" Visibility="Collapsed" Background="#B5A21B00">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="OfflineTitle" FontSize="52" FontWeight="Bold"
                           Foreground="#FFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="OfflineBody" FontSize="28" Foreground="#FFE9D5"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============ スクリーンセーバ (無操作 screensaver_after_s — 黒背景 + 漂う時計) ============ -->
        <Canvas x:Name="ScreensaverView" Visibility="Collapsed" Background="#000000">
            <StackPanel x:Name="SaverBlock" Canvas.Left="120" Canvas.Top="120">
                <TextBlock x:Name="SaverClock" FontSize="64" FontWeight="Light"
                           Foreground="#39424C"/>
                <TextBlock x:Name="SaverDate" FontSize="20" Foreground="#242B33"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Canvas>

        <!-- ============ 緊急事態 (SOS — 自端末発報 / 他端末発報の受信で表示) ============ -->
        <Grid x:Name="EmergencyView" Visibility="Collapsed" Background="#C62828">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EmergencyTitle" FontSize="110" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmergencyNote" FontSize="30" Foreground="#FFE3DE"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <Button x:Name="EmergencyCancelButton" FontSize="30" Padding="64,18"
                        Margin="0,64,0,0" Background="#7F1D1D" Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF" HorizontalAlignment="Center"
                        Click="OnEmergencyCancelClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ 夜間モード red tint (最前面・非ヒットテスト) ============ -->
        <Border x:Name="NightTint" Visibility="Collapsed" Background="#33FF2200"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
