<Window x:Class="DoorbellApp.AdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" WindowStyle="ToolWindow" Topmost="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="Prompt" FontSize="18" Foreground="{DynamicResource Fg}"
                   HorizontalAlignment="Center"/>
        <!-- The cluster 管理パスワード may be any text, so the keypad types into a real password
             box rather than a digits-only buffer (spec 5.5). -->
        <PasswordBox x:Name="PasswordEntry" FontSize="30" Margin="0,14,0,0" MinHeight="52"
                     MaxLength="128" Padding="12,6" HorizontalContentAlignment="Center"
                     Background="{DynamicResource Card}" Foreground="{DynamicResource Fg}"
                     BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
        <TextBlock x:Name="ErrorText" FontSize="14" Foreground="#FF6B6B" Margin="0,4,0,8"
                   HorizontalAlignment="Center" MinHeight="18" TextWrapping="Wrap"/>
        <UniformGrid Columns="3" Rows="4">
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="30"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="MinHeight" Value="64"/>
                    <Setter Property="Background" Value="{DynamicResource Card}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#243040"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UniformGrid.Resources>
            <Button Content="1" Tag="1" Click="OnPad"/>
            <Button Content="2" Tag="2" Click="OnPad"/>
            <Button Content="3" Tag="3" Click="OnPad"/>
            <Button Content="4" Tag="4" Click="OnPad"/>
            <Button Content="5" Tag="5" Click="OnPad"/>
            <Button Content="6" Tag="6" Click="OnPad"/>
            <Button Content="7" Tag="7" Click="OnPad"/>
            <Button Content="8" Tag="8" Click="OnPad"/>
            <Button Content="9" Tag="9" Click="OnPad"/>
            <Button Content="⌫" Tag="back" Click="OnPad"/>
            <Button Content="0" Tag="0" Click="OnPad"/>
            <Button x:Name="OkPadBtn" Content="OK" Tag="ok" Click="OnPad"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"/>
        </UniformGrid>
        <Button x:Name="CancelBtn" FontSize="16" Padding="20,8" Margin="0,12,0,0"
                HorizontalAlignment="Center" MinWidth="160"
                Background="{DynamicResource Card}" Foreground="{DynamicResource Fg}"
                BorderBrush="{DynamicResource Line}" Click="OnCancel"/>
    </StackPanel>
</Window>
