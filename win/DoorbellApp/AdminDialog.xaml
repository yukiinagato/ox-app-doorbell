<Window x:Class="DoorbellApp.AdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="管理" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="Prompt" FontSize="18" TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>
        <!-- The cluster 管理パスワード may be any text, so the keypad types into a real password
             box rather than a digits-only buffer (spec 5.5). -->
        <PasswordBox x:Name="PasswordEntry" FontSize="30" Margin="0,14,0,0" MinHeight="52"
                     MaxLength="128" HorizontalContentAlignment="Center"/>
        <TextBlock x:Name="ErrorText" FontSize="14" Foreground="{DynamicResource Negative}" Margin="0,4,0,8"
                   HorizontalAlignment="Center" MinHeight="18" TextWrapping="Wrap"/>
        <UniformGrid Columns="3" Rows="4">
            <UniformGrid.Resources>
                <!-- Keypad keys: Fluent buttons at keypad size. -->
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="FontSize" Value="28"/>
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="MinHeight" Value="64"/>
                </Style>
                <Style x:Key="KeypadAccept" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                    <Setter Property="FontSize" Value="24"/>
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="MinHeight" Value="64"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                </Style>
            </UniformGrid.Resources>
            <Button Content="1" Tag="1" Click="OnPad"/>
            <Button Content="2" Tag="2" Click="OnPad"/>
            <Button Content="3" Tag="3" Click="OnPad"/>
            <Button Content="4" Tag="4" Click="OnPad"/>
            <Button Content="5" Tag="5" Click="OnPad"/>
            <Button Content="6" Tag="6" Click="OnPad"/>
            <Button Content="7" Tag="7" Click="OnPad"/>
            <Button Content="8" Tag="8" Click="OnPad"/>
            <Button Content="9" Tag="9" Click="OnPad"/>
            <Button Tag="back" Click="OnPad">
                <Viewbox Width="26" Height="26">
                    <Path Data="{StaticResource IconBackspace}"
                          Stroke="{DynamicResource Fg}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Viewbox>
            </Button>
            <Button Content="0" Tag="0" Click="OnPad"/>
            <Button x:Name="OkPadBtn" Content="OK" Tag="ok" Click="OnPad"
                    Style="{StaticResource KeypadAccept}"/>
        </UniformGrid>
        <Button x:Name="CancelBtn" FontSize="16" Padding="20,8" Margin="0,12,0,0"
                HorizontalAlignment="Center" MinWidth="160" MinHeight="44"
                Click="OnCancel"/>
    </StackPanel>
</Window>
