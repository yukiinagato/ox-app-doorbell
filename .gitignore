# build outputs
/build/
/build-*/
/core/build/
# pjsip は fetch スクリプトで取得 (SHA256 ピンのみ追跡)
/core/third_party/pjsip/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# generated i18n (regenerated by tools/gen_i18n.py; committed copies live under each app dir)
/webui/locale/

# platform
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
*.user
xcuserdata/
DerivedData/

# android
android/.gradle/
android/local.properties
android/**/build/
android/**/.cxx/

# ios (run-script が CMake で生成する core 静的 lib 置き場)
ios/build/

# secrets — never commit
*.keystore
*.p12
*.mobileprovision
deploy/**/secrets*

# python
__pycache__/
*.pyc

# ローカル IDE/エージェント設定
/.claude/

# 抽取的 iOS SDK (从用户的 Xcode DMG,不进 git)
/tools/sdk/
/tools/toolchain/
# LLVM ソース (build_libcxx_ios5.sh がダウンロード/展開。成果物も巨大 → git に入れない)
/tools/llvm-src/
