# build outputs
/build/
/build-*/
/build-ios5/
/core/build/
/core/build-*/
# iOS5/armv7 (旧 iPad) core クロスビルドの成果物置き場 (build_core_ios5.sh)
/ios-legacy/lib/
# iOS5/armv7 殻 (.app) のビルド成果物 (build_app.sh)
/ios-legacy/build/
# pjsip は fetch スクリプトで取得 (SHA256 ピンのみ追跡)
/core/third_party/pjsip/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Generated i18n is committed for every client, including Web, so fresh builds embed the same
# deterministic locale assets that tools/gen_i18n.py --check verifies.

# platform
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
*.user
xcuserdata/
DerivedData/

# android
android/.gradle/
android/local.properties
android/**/build/
android/**/.cxx/
# Kotlin build tooling session state (AGP 8 / Kotlin 2 writes this next to the module).
android/.kotlin/

# ios (run-script が CMake で生成する core 静的 lib 置き場)
ios/build/

# secrets — never commit
*.keystore
*.p12
*.mobileprovision
deploy/**/secrets*

# python
__pycache__/
*.pyc

# ローカル IDE/エージェント設定
/.claude/

# 抽取的 iOS SDK (从用户的 Xcode DMG,不进 git)
/tools/sdk/
/tools/toolchain/
# LLVM ソース (build_libcxx_ios5.sh がダウンロード/展開。成果物も巨大 → git に入れない)
/tools/llvm-src/
/ios-kiosk/build/
/ios-kiosk/lib/
