<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.keihan.doorbell.keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/doorbell-keepalive</string>
    <string>--socket</string>
    <string>/var/run/doorbell-keepalive.sock</string>
    <string>--status</string>
    <string>/var/run/doorbell-keepalive-status.json</string>
    <string>--marker</string>
    <string>/var/db/doorbell-keepalive-safe-mode.json</string>
    <string>--mode-file</string>
    <string>/var/db/doorbell-keepalive-mode</string>
    <string>--disable-file</string>
    <string>/var/db/doorbell-keepalive.disable</string>
    <string>--log-max-bytes</string>
    <string>262144</string>
    <string>--mode</string>
    <string>auto</string>
    <string>--profile</string>
    <string>ios5</string>
    <string>--app-uid</string>
    <string>501</string>
    <string>--socket-gid</string>
    <string>501</string>
  </array>
  <key>UserName</key>
  <string>root</string>
  <key>GroupName</key>
  <string>wheel</string>
  <key>Umask</key>
  <integer>23</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/doorbell-keepalive.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/doorbell-keepalive.log</string>
</dict>
</plist>
