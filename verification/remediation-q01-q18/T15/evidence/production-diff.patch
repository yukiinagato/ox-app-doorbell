+  frame.format = 3; frame.w = 8; frame.h = 8; frame.stride = 32; frame.ts_ms = 1;
+  frame.data.assign(8 * 8 * 4, 128);
+  bus.push(std::move(frame));
+  const auto bytes = bus.latestJpeg();
+  return std::string(bytes.begin(), bytes.end());
+}
