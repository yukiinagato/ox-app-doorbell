+  other.administrator = true;
+  CHECK(store.operationQuery(id, other, 1001, 100001).error_code.empty());
+  CHECK(store.operationAccept(id, other, 1001, 100001).error_code == "forbidden");
+  OperationIntent sos{{"sos_start", "", "{}"}, "", "{}"};
