+      Store store;
+      if (!store.open(files.path) || !store.operationStart("authority-a", 100000)) ::_exit(10);
+      const auto prepared = store.operationPrepare(intent(), authorization(), 1000, 100000);
+      if (!prepared.record) ::_exit(11);
