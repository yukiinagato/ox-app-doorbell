+  CHECK(store.operationPrepare(parameterized, authorization(), 1000, 100000).error_code == "invalid_request");
+  parameterized.target_json = "{} trailing";
+  CHECK(store.operationPrepare(parameterized, authorization(), 1000, 100000).error_code == "invalid_request");
+}
