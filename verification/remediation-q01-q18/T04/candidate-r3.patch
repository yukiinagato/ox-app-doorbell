+bool Runloop::cancelQueued(uint64_t id) {
+  if (id == 0) return false;
+  std::lock_guard<std::mutex> lk(mu_);
+  for (auto it = queue_.begin(); it != queue_.end(); ++it) {
+    if (it->second.id == id) {
+      queue_.erase(it);
+      return true;
+    }
+  }
+  return false;
+}
