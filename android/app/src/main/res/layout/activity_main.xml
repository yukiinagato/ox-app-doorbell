<?xml version="1.0" encoding="utf-8"?>
<!-- WPF 版 MainWindow.xaml と同じ 4 状態: 待機 / 呼び出し中 / 返信バナー / オフライン。
     待機画面は上から 時計 / 大ボタン (用件なしの汎用呼出) / 用件ボタン / 訪客言語バー。
     テーマ背景 (theme_bg) は最背面、夜間 red_tint (night_tint) は最前面に重なる。
     カメラ Surface は采集維持のため 1dp で残すが、室外機 UI にはプレビュー表示しない。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- テーマ背景画像 (display.theme.bg_image / devices.<self>.local.theme.bg_image) -->
    <ImageView
        android:id="@+id/theme_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"/>

    <SurfaceView
        android:id="@+id/camera_preview"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:layout_gravity="top|end"
        android:layout_margin="0dp"/>

    <!-- ============ 待機 ============ -->
    <!-- weight で各段を画面高に比例配分 = どんな画面でも縦方向がはみ出さない。
         大ボタンは match_parent + 左右マージン + maxWidth で横方向もはみ出さない。
         訪客は一切スクロール不要で全要素が見え・押せる。 -->
    <LinearLayout
        android:id="@+id/idle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp">

        <!-- 時計 (上段) -->
        <LinearLayout
            android:id="@+id/idle_header"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="42sp"/>
            <TextView
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- 大ボタン (中段・最大) -->
        <LinearLayout
            android:id="@+id/call_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.15"
            android:gravity="center"
            android:orientation="vertical">
            <Button
                android:id="@+id/call_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginRight="36dp"
                android:maxWidth="560dp"
                android:minHeight="64dp"
                android:background="@drawable/bg_big_button"
                android:maxLines="2"
                android:textColor="@color/fg"
                android:textSize="28sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/touch_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/idle_touch_to_call"
                android:textColor="@color/dim"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- ==== 用件ボタン (config visit_purposes を order 順・3 列) ==== -->
        <LinearLayout
            android:id="@+id/purpose_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.25"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/purpose_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:maxLines="1"
                android:text="@string/idle_choose_purpose"
                android:textColor="@color/dim"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/purpose_auto_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:text="@string/purpose_ringing_hint"
                android:textColor="@color/accent"
                android:textSize="13sp"/>
            <GridLayout
                android:id="@+id/purpose_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:useDefaultMargins="false"/>
            <Button
                android:id="@+id/purpose_skip_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_big_button"
                android:maxLines="2"
                android:text="@string/purpose_call_without_selection"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ==== 訪客言語バー (config ui.languages) + ノード情報 (下段) ==== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9"
            android:padding="4dp">
            <LinearLayout
                android:id="@+id/lang_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/node_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="12sp"/>
        </FrameLayout>
    </LinearLayout>

    <!-- ============ 呼び出し中 ============ -->
    <LinearLayout
        android:id="@+id/calling_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/calling_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/calling_title"
            android:textColor="@color/fg"
            android:textSize="44sp"
            android:textStyle="bold"/>
        <View
            android:id="@+id/pulse"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/pulse_circle"/>
        <Button
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_button"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/calling_cancel"
            android:textColor="@color/fg"
            android:textSize="26sp"/>
    </LinearLayout>

    <!-- ============ クイック返信バナー (最前面オーバーレイ) ============ -->
    <LinearLayout
        android:id="@+id/reply_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_reply_card"
        android:gravity="center_horizontal"
        android:maxWidth="640dp"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/reply_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reply_banner"
            android:textColor="@color/dim"
            android:textSize="20sp"/>
        <TextView
            android:id="@+id/reply_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/fg"
            android:textSize="40sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ============ オフライン ============ -->
    <LinearLayout
        android:id="@+id/offline_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/offline_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/offline_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/offline_body"
            android:textColor="#FFE9D5"
            android:textSize="24sp"/>
    </LinearLayout>

    <!-- 隠し管理入口 (右上 200dp を 5 秒内 7 連打) -->
    <View
        android:id="@+id/secret_corner"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"/>

    <!-- 夜間モード red tint (最前面・非タッチ。背景画像が明るくても夜間は暗くなる) -->
    <View
        android:id="@+id/night_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FF2200"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"/>
</FrameLayout>
