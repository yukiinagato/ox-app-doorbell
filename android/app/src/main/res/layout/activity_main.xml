<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <ImageView
        android:id="@+id/theme_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/dashboard_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/visitor_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ScrollView
                android:id="@+id/idle_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/visitor_split"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/visitor_col_a"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical" />
                        <LinearLayout
                            android:id="@+id/visitor_col_b"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/touch_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/door_hint_call"
                        android:textColor="@color/dim"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:id="@+id/idle_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/clock_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:maxLines="1"
                            android:textColor="@color/fg"
                            android:textSize="52sp" />
                        <TextView
                            android:id="@+id/date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/dim"
                            android:textSize="15sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/notice_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="8dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/fg"
                        android:textSize="15sp"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/lang_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/purpose_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/purpose_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:maxLines="4"
                            android:text="@string/idle_choose_purpose"
                            android:textColor="@color/dim"
                            android:textSize="14sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/purpose_auto_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:maxLines="4"
                            android:text="@string/calling_title"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:gravity="center" />
                        <GridLayout
                            android:id="@+id/purpose_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alignmentMode="alignMargins"
                            android:columnCount="3"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:useDefaultMargins="false" />
                        <LinearLayout
                            style="?android:attr/buttonBarStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="16dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/purpose_skip_button"
                                style="?android:attr/buttonBarButtonStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/bg_big_button"
                                android:maxLines="2"
                                android:text="@string/purpose_skip"
                                android:textColor="@color/fg"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:minHeight="48dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/visitor_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="vertical"
                        android:paddingTop="6dp">
                        <TextView
                            android:id="@+id/node_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:textColor="@color/dim"
                            android:textSize="12sp" />
                        <FrameLayout
                            android:id="@+id/sos_slot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minWidth="200dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <ScrollView
                android:id="@+id/calling_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:visibility="gone"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">
                    <TextView
                        android:id="@+id/calling_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/calling_title"
                        android:textColor="@color/fg"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <View
                        android:id="@+id/pulse"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/pulse_circle" />
                </LinearLayout>
            </ScrollView>
            <ScrollView
                android:id="@+id/offline_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:visibility="gone"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">
                    <TextView
                        android:id="@+id/offline_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/offline_title"
                        android:textColor="@color/fg"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/offline_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/offline_body"
                        android:textColor="@color/dim"
                        android:textSize="18sp"
                        android:gravity="center" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
        <TextView
            android:id="@+id/visitor_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="@color/card"
            android:gravity="center"
            android:maxLines="3"
            android:padding="12dp"
            android:textColor="@color/fg"
            android:textSize="18sp"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/visitor_action_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:id="@+id/call_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <Button
                    android:id="@+id/call_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_big_button"
                    android:maxLines="4"
                    android:maxWidth="560dp"
                    android:minHeight="72dp"
                    android:textColor="@color/fg"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:gravity="center"
                    android:visibility="visible" />
            </LinearLayout>
            <Button
                android:id="@+id/purpose_cancel_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_button"
                android:maxLines="4"
                android:text="@string/purpose_cancel_call"
                android:textColor="@color/fg"
                android:textSize="24sp"
                android:visibility="gone"
                android:minHeight="72dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_button"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:text="@string/calling_cancel"
                android:textColor="@color/fg"
                android:textSize="24sp"
                android:minHeight="72dp"
                android:maxLines="4"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/reply_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_reply_card"
        android:gravity="center_horizontal"
        android:maxWidth="640dp"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/reply_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reply_banner"
            android:textColor="@color/dim"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/reply_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/fg"
            android:textSize="40sp"
            android:textStyle="bold" />
    </LinearLayout>
    <View
        android:id="@+id/secret_corner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent" />
    <View
        android:id="@+id/night_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FF2200"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
    <TextView
        android:id="@+id/pairing_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginEnd="130dp"
        android:layout_marginRight="130dp"
        android:background="#243244"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:text="@string/pair_not_set_up_banner"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        android:layout_marginTop="8dp" />
</FrameLayout>
