<?xml version="1.0" encoding="utf-8"?>
<!-- Touch- and D-pad-compatible visitor monitor with full-screen video and quick replies. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- H.264 renders directly to a Surface; the ImageView is the MJPEG fallback. -->
    <TextureView
        android:id="@+id/live_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/live_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/no_video_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/ring_no_video"
        android:textColor="@color/dim"
        android:textSize="24sp"/>

    <!-- Door label and state. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_reply_card"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/door_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="34sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/accent"
            android:textSize="22sp"/>

        <!-- Purpose and visitor-language badges. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/purpose_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/lang_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_badge"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:visibility="gone"/>
        </LinearLayout>
        <TextView
            android:id="@+id/audio_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ring_monitoring"
            android:textColor="@color/dim"
            android:textSize="16sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divide available height among all actions so none require scrolling. -->
    <LinearLayout
        android:id="@+id/reply_list"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#B310151B"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">
            <!-- Bidirectional answer/end action. -->
            <Button
                android:id="@+id/answer_button"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:maxLines="2"
                android:text="@string/ring_answer"
                android:textColor="@color/accent"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <!-- Configured quick replies are inserted before the close action. -->
            <Button
                android:id="@+id/close_button"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:maxLines="2"
                android:text="@string/ring_ignore"
                android:textColor="@color/dim"
                android:textSize="18sp"/>
    </LinearLayout>

    <!-- Sent confirmation. -->
    <TextView
        android:id="@+id/sent_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_reply_card"
        android:padding="32dp"
        android:textColor="@color/fg"
        android:textSize="30sp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/sos_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:background="#B00020"
        android:focusable="true"
        android:minWidth="88dp"
        android:minHeight="56dp"
        android:text="@string/emergency_button"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"/>
</FrameLayout>
