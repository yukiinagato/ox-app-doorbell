<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emergency_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/emergency_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/emergency_title"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/emergency_source_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/emergency_notified"
        android:textColor="#FFFFFF"
        android:textSize="24sp"/>

    <Button
        android:id="@+id/emergency_clear_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="#B00020"
        android:minWidth="160dp"
        android:minHeight="56dp"
        android:text="@string/emergency_cancel"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>
</LinearLayout>
