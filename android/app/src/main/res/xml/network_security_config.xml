<?xml version="1.0" encoding="utf-8"?>
<!-- Security v3 (docs/en/security-v3.md sections 7 and 8).

     The shell speaks plain HTTP only to its own Core on loopback: Core publishes peer media as
     loopback proxy URLs and fetches peers itself over pinned HTTPS, and the LAN-facing plain
     port only redirects to HTTPS. Cleartext is therefore permitted for loopback alone.

     A Network Security Config applies from API 24. API 21-23 fall back to the modern manifest's
     android:usesCleartextTraffic, and API 19 permits cleartext outright; on those platforms the
     loopback-only rule is enforced by where the shell sends requests, not by the OS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
