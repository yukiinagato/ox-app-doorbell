<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- legacy19 targets API 19 hardware, but a sideloaded APK can still land on a newer OS. Every
         declaration below is ignored by API 19's package parser and lets the same APK start its
         foreground service on API 28+ and 34+ instead of failing in startForeground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application>
        <service
            android:name=".DoorbellService"
            android:foregroundServiceType="specialUse|camera|microphone"
            tools:targetApi="29">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Doorbell resident mesh, notification, and SIP runtime"/>
        </service>
    </application>
</manifest>
