+	int waited_ms = 0;
+	mbedtls_net_context net;
+	net.fd = fd;
 	while ((rc = mbedtls_ssl_handshake(ssl)) != 0) {
+		uint32_t want;
 		if (rc != MBEDTLS_ERR_SSL_WANT_READ && rc != MBEDTLS_ERR_SSL_WANT_WRITE
 		    && rc != MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS) {
 			break;
 		}
+		if (waited_ms >= DB_TLS_HANDSHAKE_TIMEOUT_MS) {
+			rc = MBEDTLS_ERR_SSL_TIMEOUT;
+			break;
+		}
+		want = rc == MBEDTLS_ERR_SSL_WANT_WRITE ? MBEDTLS_NET_POLL_WRITE
+		                                        : MBEDTLS_NET_POLL_READ;
+		if (mbedtls_net_poll(&net, want, 200) < 0) {
+			break;
+		}
+		waited_ms += 200;
